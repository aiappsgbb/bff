---
import { JOURNEY } from '../data/content';
import { withBase } from '../data/site';
const accents = ['yellow', 'green', 'blue', 'purple'];
---

<ol class="bff-journey not-content">
	{
		JOURNEY.map((j, i) => (
			<li data-accent={accents[i]}>
				<a href={withBase(j.href)}>
					<span class="bff-journey-n">{String(i + 1).padStart(2, '0')}</span>
					<span class="bff-journey-kicker">{j.kicker}</span>
					<strong>{j.title}</strong>
					<span class="bff-journey-text">{j.text}</span>
					<span class="bff-journey-go" aria-hidden="true">→</span>
				</a>
			</li>
		))
	}
</ol>

<style>
	.bff-journey {
		position: relative;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: j;
	}
	.bff-journey::before {
		content: '';
		position: absolute;
		inset: 1.55rem 2rem auto 2rem;
		block-size: 1px;
		background: var(--sl-color-gray-5);
	}
	.bff-journey > li {
		margin: 0;
	}
	a {
		position: relative;
		display: grid;
		align-content: start;
		gap: 0.45rem;
		block-size: 100%;
		padding: 0 0.25rem 1rem;
		color: inherit;
		text-decoration: none;
	}
	.bff-journey-n {
		position: relative;
		display: grid;
		place-items: center;
		inline-size: 3.1rem;
		block-size: 3.1rem;
		margin-bottom: 0.6rem;
		border: 1px solid var(--accent);
		border-radius: var(--bff-radius-md);
		background: var(--sl-color-black);
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-sm);
		color: var(--accent-ink, var(--accent));
		transition:
			background-color 0.25s var(--bff-ease-soft),
			color 0.25s var(--bff-ease-soft);
	}
	a:hover .bff-journey-n {
		background: var(--accent);
		color: var(--bff-on-accent);
	}
	.bff-journey-kicker {
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-2xs);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--sl-color-gray-3);
	}
	strong {
		font-size: var(--bff-text-xl);
		font-weight: 560;
		color: var(--sl-color-white);
	}
	.bff-journey-text {
		font-size: var(--bff-text-md);
		color: var(--sl-color-gray-3);
	}
	.bff-journey-go {
		color: var(--accent-ink, var(--accent));
		transition: transform 0.3s var(--bff-ease-out);
	}
	a:hover .bff-journey-go {
		transform: translateX(4px);
	}
	@media (max-width: 56em) {
		.bff-journey {
			grid-template-columns: 1fr 1fr;
			row-gap: 2rem;
		}
		.bff-journey::before {
			display: none;
		}
	}
	@media (max-width: 34em) {
		.bff-journey {
			grid-template-columns: 1fr;
		}
	}
</style>
