---
import { data, LAYER_META, VENDOR_LABEL, type Vendor } from '../data/site';
import ProductChip from './ProductChip.astro';

// framework.json carries its own short keys (sup/found); the site key must win so data-layer matches the CSS.
const bands = (['hq', 'floor', 'foundations'] as const).map((k) => ({
	...data.layers[k],
	key: k,
	meta: LAYER_META[k],
	anchor: k === 'hq' ? 'factory-hq' : k === 'floor' ? 'factory-floor' : 'factory-foundations',
}));
// Engineering loop steps map one-to-one onto the layers they improve.
const steps = data.loop.map((l, i) => ({ ...l, layer: bands[i].key, label: bands[i].label }));
const vendors = Object.keys(VENDOR_LABEL) as Vendor[];
const uid = 'bff-bp';
---

<div class="bff-bp not-content" data-view="capabilities" id={uid}>
	<a class="bff-bp-skip" href={`#${uid}-end`}>Skip the big picture</a>
	<div class="bff-bp-toolbar">
		<div class="bff-bp-view">
			<span class="bff-bp-label" id={`${uid}-view`}>View</span>
			<div class="bff-tabs" role="group" aria-labelledby={`${uid}-view`}>
				<button class="bff-tab" type="button" aria-pressed="true" data-view-btn="capabilities">Capabilities</button>
				<button class="bff-tab" type="button" aria-pressed="false" data-view-btn="products">Products</button>
			</div>
			<button class="bff-bp-expand" type="button" aria-expanded="false" aria-controls={`${uid}-grid`} data-expand>
				<span data-expand-label>Expand all</span>
			</button>
		</div>
		<fieldset class="bff-bp-vendors" disabled>
			<legend class="bff-bp-label">Vendors</legend>
			{
				vendors.map((v) => (
					<label class="bff-bp-vendor" data-vendor={v}>
						<input type="checkbox" checked value={v} />
						{VENDOR_LABEL[v]}
					</label>
				))
			}
			<span class="bff-bp-hint" data-show="capabilities">
				Switch to Products to filter by vendor.
			</span>
		</fieldset>
	</div>
	<p class="bff-bp-empty" data-empty-all hidden>
		No vendors selected, so no products are shown.
		<button class="bff-action" type="button" data-reset>Show all vendors</button>
	</p>

	<div class="bff-bp-grid" id={`${uid}-grid`}>
		<div class="bff-bp-bands">
			{
				bands.map((b, i) => (
					<>
						{i === 1 && (
							<div class="bff-bp-flow" aria-label="Between HQ and floor">
								<span>
									<span aria-hidden="true">↓</span> intent · steering · approvals
								</span>
								<span>
									<span aria-hidden="true">↑</span> evidence · signals · cost
								</span>
							</div>
						)}
						<section class="bff-bp-band" data-layer={b.key} aria-labelledby={`${b.anchor}`}>
							<header>
								<p class="bff-bp-who">{b.meta.who}</p>
								<h3 id={b.anchor}>{b.label}</h3>
								<p class="bff-bp-tag">{b.tag}</p>
							</header>
							<ul class="bff-bp-cards">
								{b.components.map((c) => (
									<li class="bff-bp-card">
										<details>
											<summary>
												<span class="bff-bp-card-title">
													{c.name}
													{c.stages && <span class="bff-bp-stages">{c.stages}</span>}
												</span>
												<span class="bff-bp-count" data-show="capabilities">
													{c.items.length}
													<span class="sr-only"> capabilities</span>
												</span>
												<span class="bff-bp-count" data-show="products">
													<span data-count>{c.products.length}</span>
													<span class="sr-only"> products</span>
												</span>
											</summary>
											<ul class="bff-bp-items" data-show="capabilities">
												{c.items.map((it) => (
													<li>{it}</li>
												))}
											</ul>
											<ul class="bff-chips" data-show="products">
												{c.products.map((p) => (
													<li data-vendor={p.vendor}>
														<ProductChip product={p} />
													</li>
												))}
											</ul>
											<p class="bff-bp-none" data-show="products">
												No products from the selected vendors.
											</p>
										</details>
									</li>
								))}
							</ul>
						</section>
					</>
				))
			}
		</div>
		<aside class="bff-bp-eng" data-layer="engineering" aria-labelledby="factory-engineering">
			<svg class="bff-bp-loop" aria-hidden="true" focusable="false">
				<path class="bff-bp-loop-track" data-track />
				<path class="bff-bp-loop-trail" data-trail />
				<g class="bff-bp-loop-heads" data-heads />
				<g class="bff-bp-loop-label" data-label><rect /><text>self-improving loop</text></g>
				<circle class="bff-bp-loop-dot" data-dot r="3.5" />
			</svg>
			{
				steps.map((s, i) => (
					<>
						{i === 1 && <div class="bff-bp-eng-cell" aria-hidden="true" />}
						<div class="bff-bp-eng-cell">
							{i === 0 && (
								<header>
									<p class="bff-bp-who">Platform + AI engineers</p>
									<h3 id="factory-engineering">Factory engineering</h3>
									<p class="bff-bp-tag">Sets up the factory and improves it every loop.</p>
								</header>
							)}
							<div class="bff-bp-step" data-layer={s.layer}>
								<h4>
									<span class="bff-bp-step-n">{i + 1}</span> {s.step}
								</h4>
								<p>{s.detail}</p>
								<p class="sr-only">
									Improves the {s.label}.{i === steps.length - 1 && ' Then the loop repeats from step 1.'}
								</p>
							</div>
							{i === steps.length - 1 && (
								<a class="bff-card-more" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/framework/engineering/`}>
									The engineering loop →
								</a>
							)}
						</div>
					</>
				))
			}
		</aside>
	</div>
	<p class="bff-bp-status" aria-live="polite" data-status></p>
	<span class="bff-bp-end" id={`${uid}-end`} tabindex="-1"></span>
</div>

<script>
	document.querySelectorAll<HTMLElement>('.bff-bp').forEach((root) => {
		const viewBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-view-btn]')];
		const status = root.querySelector<HTMLElement>('[data-status]')!;
		const vendors = root.querySelector<HTMLFieldSetElement>('.bff-bp-vendors')!;
		const boxes = [...vendors.querySelectorAll<HTMLInputElement>('input')];
		const cards = [...root.querySelectorAll<HTMLDetailsElement>('.bff-bp-card details')];
		const emptyAll = root.querySelector<HTMLElement>('[data-empty-all]')!;
		root.querySelector('[data-reset]')!.addEventListener('click', () => {
			boxes.forEach((b) => (b.checked = true));
			update();
			boxes[0]?.focus();
		});
		const expand = root.querySelector<HTMLButtonElement>('[data-expand]')!;
		const expandLabel = expand.querySelector<HTMLElement>('[data-expand-label]')!;
		const syncExpand = () => {
			const all = cards.every((d) => d.open);
			expand.setAttribute('aria-expanded', String(all));
			expandLabel.textContent = all ? 'Collapse all' : 'Expand all';
		};
		expand.addEventListener('click', () => {
			const open = !cards.every((d) => d.open);
			cards.forEach((d) => (d.open = open));
			syncExpand();
		});
		// `toggle` doesn't bubble; capture it once for every card.
		root.addEventListener('toggle', syncExpand, true);
		const update = () => {
			const on = boxes.filter((b) => b.checked).map((b) => b.value);
			boxes.forEach((b) => root.toggleAttribute(`data-hide-${b.value}`, !b.checked));
			if (root.dataset.view === 'products') {
				let visible = 0;
				let shown = 0;
				cards.forEach((d) => {
					const chips = [...d.querySelectorAll<HTMLElement>('[data-show="products"] > li')];
					const n = chips.filter((li) => on.includes(li.dataset.vendor ?? '')).length;
					visible += chips.length;
					shown += n;
					d.querySelector<HTMLElement>('[data-count]')!.textContent = String(n);
					d.toggleAttribute('data-empty', n === 0);
				});
				// A product can sit in several components, so this counts mappings, not distinct products.
				status.textContent = `Showing ${shown} of ${visible} product mappings.`;
				emptyAll.hidden = on.length > 0;
			} else {
				status.textContent = '';
				emptyAll.hidden = true;
			}
		};
		viewBtns.forEach((btn) =>
			btn.addEventListener('click', () => {
				root.dataset.view = btn.dataset.viewBtn;
				vendors.disabled = btn.dataset.viewBtn !== 'products';
				viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
				update();
			}),
		);
		boxes.forEach((b) => b.addEventListener('change', update));
	});

	// Engineering loop: arrows 1 → 2 → 3, a return rail back to 1, and a token that lights each step it passes.
	document.querySelectorAll<HTMLElement>('.bff-bp-eng').forEach((eng) => {
		const svg = eng.querySelector<SVGSVGElement>('.bff-bp-loop')!;
		const track = svg.querySelector<SVGPathElement>('[data-track]')!;
		const trail = svg.querySelector<SVGPathElement>('[data-trail]')!;
		const heads = svg.querySelector<SVGGElement>('[data-heads]')!;
		const label = svg.querySelector<SVGGElement>('[data-label]')!;
		const labelText = label.querySelector('text')!;
		const labelBg = label.querySelector('rect')!;
		const dot = svg.querySelector<SVGCircleElement>('[data-dot]')!;
		const steps = [...eng.querySelectorAll<HTMLElement>('.bff-bp-step')];
		const SPEED = 130; // px per second between steps
		const TRAIL = 36;
		let len = 0;
		let pos = 0;
		let pts = new Float32Array(0);
		let rects: { l: number; r: number; t: number; b: number }[] = [];

		const layout = () => {
			const box = eng.getBoundingClientRect();
			if (!box.width || steps.length < 2) return;
			svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
			rects = steps.map((s) => {
				const r = s.getBoundingClientRect();
				return { l: r.left - box.left, r: r.right - box.left, t: r.top - box.top, b: r.bottom - box.top };
			});
			const first = rects[0];
			const last = rects[rects.length - 1];
			const x = (first.l + first.r) / 2;
			const y0 = (first.t + first.b) / 2;
			const y1 = (last.t + last.b) / 2;
			const rail = (first.r + box.width) / 2;
			const k = Math.min(6, (rail - first.r) / 2);
			track.setAttribute(
				'd',
				`M${x} ${y0}V${y1}H${rail - k}Q${rail} ${y1} ${rail} ${y1 - k}V${y0 + k}Q${rail} ${y0} ${rail - k} ${y0}H${x}`,
			);
			trail.setAttribute('d', track.getAttribute('d')!);
			const down = (y: number) => `M${x - 4} ${y - 5}L${x} ${y}L${x + 4} ${y - 5}`;
			heads.innerHTML = rects
				.slice(1)
				.map((r) => `<path d="${down(r.t - 2)}"/>`)
				.concat(`<path d="M${first.r + 7} ${y0 - 4}L${first.r + 2} ${y0}L${first.r + 7} ${y0 + 4}"/>`)
				.join('');
			label.setAttribute('transform', `translate(${rail} ${(y0 + y1) / 2}) rotate(-90)`);
			label.style.display = '';
			const t = labelText.getBBox();
			Object.entries({ x: t.x - 4, y: t.y, width: t.width + 8, height: t.height }).forEach(([a, v]) =>
				labelBg.setAttribute(a, String(v)),
			);
			label.style.display = y1 - y0 > t.width + 24 ? '' : 'none';
			const next = track.getTotalLength();
			pos = len ? (pos / len) * next : 0;
			len = next;
			// Sample the path once per layout so frames never call getPointAtLength,
			// which would force a synchronous layout on every frame.
			pts = new Float32Array((Math.ceil(len) + 1) * 2);
			for (let i = 0, n = pts.length / 2; i < n; i++) {
				const q = track.getPointAtLength(Math.min(i, len));
				pts[i * 2] = q.x;
				pts[i * 2 + 1] = q.y;
			}
			trail.style.strokeDasharray = `${TRAIL} ${len}`;
		};

		let raf = 0;
		let then = 0;
		let active = -1;
		const frame = (t: number) => {
			const speed = active >= 0 ? SPEED * 0.4 : SPEED;
			pos = (pos + (speed * Math.min(t - (then || t), 100)) / 1000) % len;
			then = t;
			const j = Math.round(pos) * 2;
			const x = pts[j];
			const y = pts[j + 1];
			dot.setAttribute('cx', x.toFixed(1));
			dot.setAttribute('cy', y.toFixed(1));
			trail.style.strokeDashoffset = String(TRAIL - pos);
			const hit = rects.findIndex((r) => x >= r.l && x <= r.r && y >= r.t && y <= r.b);
			if (hit !== active) {
				steps[active]?.removeAttribute('data-active');
				steps[hit]?.setAttribute('data-active', '');
				active = hit;
			}
			raf = requestAnimationFrame(frame);
		};
		const reduce = matchMedia('(prefers-reduced-motion: reduce)');
		let visible = false;
		const sync = () => {
			const run = visible && !reduce.matches && !document.hidden && len > 0;
			eng.toggleAttribute('data-running', run);
			if (run && !raf) {
				then = 0;
				raf = requestAnimationFrame(frame);
			} else if (!run && raf) {
				cancelAnimationFrame(raf);
				raf = 0;
				steps[active]?.removeAttribute('data-active');
				active = -1;
			}
		};

		const ro = new ResizeObserver(() => {
			layout();
			sync();
		});
		ro.observe(eng);
		eng.parentElement?.querySelectorAll('.bff-bp-band').forEach((b) => ro.observe(b));
		document.fonts?.ready.then(layout);
		new IntersectionObserver(([e]) => {
			visible = e.isIntersecting;
			sync();
		}).observe(eng);
		reduce.addEventListener('change', sync);
		document.addEventListener('visibilitychange', sync);
	});
</script>

<style>
	.bff-bp-toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		margin-bottom: 1rem;
	}
	.bff-bp-vendors {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 1rem;
		margin: 0;
		padding: 0;
		border: 0;
		font-size: var(--bff-text-sm);
		color: var(--sl-color-gray-2);
		transition: opacity 0.2s var(--bff-ease-soft);
	}
	.bff-bp-vendors:disabled .bff-bp-vendor {
		opacity: 0.45;
		cursor: default;
	}
	.bff-bp-vendors:not(:disabled) .bff-bp-hint {
		display: none;
	}
	.bff-bp-hint {
		font-size: var(--bff-text-xs);
		color: var(--sl-color-gray-3);
	}
	.bff-bp-empty {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		margin: 0 0 1rem;
		padding: 0.75rem 1rem;
		border: 1px dashed var(--sl-color-gray-5);
		border-radius: var(--bff-radius-md);
		font-size: var(--bff-text-sm);
		color: var(--sl-color-gray-2);
	}
	.bff-bp-empty[hidden] {
		display: none;
	}
	.bff-bp-none {
		display: none;
		margin: 0;
		padding: 0 0.75rem 0.75rem;
		font-size: var(--bff-text-xs);
		color: var(--sl-color-gray-3);
	}
	.bff-bp[data-view='products'] details[data-empty] .bff-bp-none {
		display: block;
	}
	.bff-bp details[data-empty] .bff-chips {
		display: none;
	}
	.bff-bp-skip {
		position: absolute;
		inline-size: 1px;
		block-size: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.bff-bp-skip:focus-visible {
		position: static;
		display: inline-flex;
		inline-size: auto;
		block-size: auto;
		min-block-size: 1.5rem;
		margin-bottom: 0.75rem;
		overflow: visible;
		clip-path: none;
		color: var(--sl-color-accent-high);
		font-size: var(--bff-text-sm);
		font-weight: 600;
	}
	.bff-bp-end:focus {
		outline: none;
	}
	.bff-bp-view {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.bff-bp-vendors legend {
		float: left;
	}
	.bff-bp-expand {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.25rem;
		padding: 0.35rem 0.5rem;
		border: 0;
		border-radius: var(--bff-radius-sm);
		background: transparent;
		font: inherit;
		font-size: var(--bff-text-sm);
		color: var(--sl-color-gray-3);
		cursor: pointer;
		transition: color 0.2s var(--bff-ease-soft);
	}
	.bff-bp-expand:hover {
		color: var(--sl-color-white);
	}
	.bff-bp-expand::after {
		content: '';
		inline-size: 0.35rem;
		block-size: 0.35rem;
		margin-bottom: 0.15rem;
		border: solid currentColor;
		border-width: 0 1.5px 1.5px 0;
		transform: rotate(45deg);
		transition: transform 0.2s var(--bff-ease-soft);
	}
	.bff-bp-expand[aria-expanded='true']::after {
		margin: 0.15rem 0 0;
		transform: rotate(-135deg);
	}
	.bff-bp-label {
		margin-right: 0.25rem;
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-2xs);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--sl-color-gray-3);
	}
	.bff-bp-vendor {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-block-size: 1.5rem;
		cursor: pointer;
	}
	.bff-bp-vendor input {
		accent-color: var(--vendor);
	}
	.bff-bp-vendor[data-vendor='github'] { --vendor: var(--bff-vendor-github); }
	.bff-bp-vendor[data-vendor='microsoft'] { --vendor: var(--bff-vendor-microsoft); }
	.bff-bp-vendor[data-vendor='third-party'] { --vendor: var(--bff-vendor-third); }

	.bff-bp-grid {
		--bp-pad: clamp(0.9rem, 2vw, 1.25rem);
		--bp-col-gap: 1.25rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(12rem, 18rem);
		grid-template-rows: repeat(4, auto);
		gap: 0.75rem var(--bp-col-gap);
	}
	/* Bands and the engineering rail share rows, so each loop step sits beside the layer it improves. */
	.bff-bp-bands,
	.bff-bp-eng {
		display: grid;
		grid-row: 1 / -1;
		grid-template-rows: subgrid;
	}
	.bff-bp-band,
	.bff-bp-eng {
		padding: var(--bp-pad);
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--bff-radius);
		background: var(--bff-surface);
	}
	.bff-bp-who::before {
		content: '';
		display: inline-block;
		inline-size: 0.55rem;
		block-size: 0.55rem;
		margin-right: 0.45rem;
		background: var(--accent);
		vertical-align: 0.05em;
	}
	.bff-bp-band[data-layer='floor'] {
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--accent) 7%, transparent), transparent 60%),
			var(--bff-surface);
	}
	.bff-bp-band header {
		margin-bottom: 0.75rem;
	}
	/* Kept tight so the rail header plus step 1 fits beside the collapsed HQ band. */
	.bff-bp-eng header > :is(p, h3) {
		margin-bottom: 0.4rem;
	}
	.bff-bp-eng header > .bff-bp-tag {
		margin-bottom: 0.75rem;
		font-size: var(--bff-text-xs);
	}
	.bff-bp-band header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.75rem;
	}
	.bff-bp-who {
		order: -1;
		inline-size: 100%;
		margin: 0;
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-2xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-ink, var(--accent));
	}
	.bff-bp h3 {
		margin: 0;
		font-size: var(--bff-text-xl);
		font-weight: 600;
		color: var(--sl-color-white);
		scroll-margin-top: calc(var(--sl-nav-height) + 1.5rem);
	}
	.bff-bp-tag {
		margin: 0;
		font-size: var(--bff-text-sm);
		color: var(--sl-color-gray-3);
	}
	.bff-bp-cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr));
		align-items: start;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.bff-bp-card {
		margin: 0;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--bff-radius-md);
		background: var(--sl-color-black);
		transition: border-color 0.2s var(--bff-ease-soft);
	}
	.bff-bp-card:hover,
	.bff-bp-card:has(details[open]) {
		border-color: color-mix(in oklab, var(--accent) 45%, var(--sl-color-hairline));
	}
	.bff-bp-card summary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.6rem 0.75rem;
