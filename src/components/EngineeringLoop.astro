---
import { data, LEVELS, LEVEL_ORDER } from '../data/site';
import PauseButton from './PauseButton.astro';

const cx = 240;
const cy = 205;
const r = 125;
const pt = (deg: number) => {
	const a = (deg * Math.PI) / 180;
	return [+(cx + r * Math.cos(a)).toFixed(1), +(cy + r * Math.sin(a)).toFixed(1)];
};
const layers = ['hq', 'floor', 'foundations'];
const nodes = data.loop.map((s, i) => {
	const deg = -90 + i * 120;
	const [x, y] = pt(deg);
	const below = i > 0;
	return { ...s, i, x, y, layer: layers[i], lx: x, ly: below ? y + 55 : y - 50 };
});
const arrows = [-30, 90, 210].map((deg) => {
	const [x, y] = pt(deg);
	return { x, y, rot: deg + 90 };
});
const uid = 'bff-loop';
---

<figure class="bff-figure bff-loop not-content" data-pausable aria-labelledby={`${uid}-cap`}>
	<div class="bff-figure-bar">
		<p class="bff-eyebrow" data-accent="purple"><span class="bff-eyebrow-square" aria-hidden="true"></span>factory.engineering.loop()</p>
		<PauseButton />
	</div>
	<div class="bff-loop-grid">
		<svg class="bff-loop-svg" viewBox="0 0 480 410" role="img" aria-labelledby={`${uid}-title`}>
			<title id={`${uid}-title`}>The factory engineering loop: tune trust and control, expand automation, strengthen foundations, and repeat.</title>
			<circle class="bff-loop-ring" cx={cx} cy={cy} r={r} />
			{arrows.map((a) => <path class="bff-loop-arrow" d="M -7 -6 L 6 0 L -7 6 Z" transform={`translate(${a.x} ${a.y}) rotate(${a.rot})`} />)}
			<g class="bff-loop-orbit">
				<circle class="bff-loop-dot" cx={cx} cy={cy - r} r="7" />
			</g>
			<text class="bff-loop-center" x={cx} y={cy - 6} text-anchor="middle">Factory</text>
			<text class="bff-loop-center" x={cx} y={cy + 22} text-anchor="middle">engineering</text>
			{
				nodes.map((n) => (
					<g class="bff-loop-node" data-layer={n.layer}>
						<circle cx={n.x} cy={n.y} r="22" />
						<text class="bff-loop-num" x={n.x} y={n.y + 6} text-anchor="middle">{n.i + 1}</text>
						<text class="bff-loop-label" x={n.lx} y={n.ly} text-anchor="middle">{n.step}</text>
						<text class="bff-loop-detail" x={n.lx} y={n.ly + 22} text-anchor="middle">{n.detail}</text>
					</g>
				))
			}
		</svg>
		<div class="bff-loop-panel">
			<div class="bff-tabs" role="tablist" aria-label="Automation level">
				{
					LEVEL_ORDER.map((k, i) => (
						<button
							class="bff-tab"
							type="button"
							role="tab"
							id={`${uid}-tab-${k}`}
							aria-controls={`${uid}-panel-${k}`}
							aria-selected={k === 'medium' ? 'true' : 'false'}
							tabindex={k === 'medium' ? 0 : -1}
							data-level={k}
						>
							{LEVELS[k].gait} <span class="bff-tab-sub">{LEVELS[k].name}</span>
						</button>
					))
				}
			</div>
			{
				LEVEL_ORDER.map((k) => (
					<div class="bff-loop-tasks" role="tabpanel" id={`${uid}-panel-${k}`} aria-labelledby={`${uid}-tab-${k}`} hidden={k !== 'medium'} tabindex="0">
						{data.levels[k].engineering.map((e, i) => (
							<section data-layer={layers[i]}>
								<h4>
									<span class="bff-loop-badge" aria-hidden="true">{i + 1}</span>
									{e.step}
								</h4>
								<ul>
									{e.tasks.map((t) => (
										<li>{t}</li>
									))}
								</ul>
							</section>
						))}
					</div>
				))
			}
		</div>
	</div>
	<figcaption id={`${uid}-cap`}>
		Factory engineering sets up the factory and runs the loop. Each turn tunes trust and control, expands automation and strengthens
		the foundations, so the factory improves every cycle.
	</figcaption>
</figure>

<script>
	import { bindTabs } from '../lib/tabs';
	document.querySelectorAll<HTMLElement>('.bff-loop').forEach((el) => bindTabs(el, { syncLevel: true }));
</script>

<style>
	.bff-loop-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		gap: clamp(1rem, 3vw, 2.5rem);
		align-items: center;
	}
	.bff-loop-svg {
		display: block;
		inline-size: 100%;
		max-inline-size: 30rem;
		block-size: auto;
		margin-inline: auto;
		overflow: visible;
	}
	.bff-loop-ring {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 2;
		stroke-dasharray: 3 9;
	}
	.bff-loop-arrow {
		fill: var(--sl-color-gray-4);
	}
	.bff-loop-orbit {
		transform-origin: 240px 205px;
		animation: bff-loop-spin 9s linear infinite;
	}
	.bff-loop-dot {
		fill: var(--bff-eng);
		filter: drop-shadow(0 0 6px var(--bff-eng));
	}
	.bff-loop-center {
		fill: var(--sl-color-white);
		font-size: calc(var(--bff-text-xl) * 1.2);
		font-weight: 600;
	}
	.bff-loop-node circle {
		fill: var(--accent);
	}
	.bff-loop-num {
		fill: var(--bff-on-accent);
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-lg);
		font-weight: 700;
	}
	.bff-loop-label {
		fill: var(--sl-color-white);
		font-size: var(--bff-text-lg);
		font-weight: 600;
	}
	.bff-loop-detail {
		fill: var(--sl-color-gray-3);
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-sm);
	}
	@keyframes bff-loop-spin {
		to { transform: rotate(360deg); }
	}
	.bff-loop-tasks {
		display: grid;
		gap: 1rem;
		margin-top: 1rem;
	}
	.bff-loop-tasks section {
		padding: 0.85rem 1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--bff-radius-md);
		background: var(--sl-color-black);
	}
	.bff-loop-tasks h4 {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.35rem;
		font-size: var(--bff-text-md);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.bff-loop-badge {
		display: inline-grid;
		place-items: center;
		inline-size: 1.4rem;
		block-size: 1.4rem;
		border-radius: var(--bff-radius-pill);
		background: var(--accent);
		color: var(--bff-on-accent);
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-2xs);
		font-weight: 700;
	}
	.bff-loop-tasks ul {
		margin: 0;
		padding-left: 1.1rem;
		color: var(--sl-color-gray-2);
		font-size: var(--bff-text-sm);
	}
	@media (max-width: 50em) {
		.bff-loop-grid {
			grid-template-columns: 1fr;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.bff-loop-orbit {
			animation: none;
		}
	}
</style>
