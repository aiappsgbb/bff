---
// Still frames of the hero factory scene, with the same people, robots and floor
// lighting as the animated hero. `dark` is the busiest floor with nobody in the HQ.
// Pass every frame a script may switch to via `data-level`; they stack and crossfade.
import { getImage } from 'astro:assets';
import low from '../assets/factory/level-low.png';
import medium from '../assets/factory/level-medium.png';
import high from '../assets/factory/level-high.png';
import dark from '../assets/factory/level-dark.png';

type Frame = 'low' | 'medium' | 'high' | 'dark';
interface Props {
	level: Frame;
	frames?: Frame[];
	alt?: string;
	sizes?: string;
	class?: string;
}
const { level, frames: list = [level], alt = '', sizes = '(min-width: 60em) 24rem, 92vw', class: className } = Astro.props;
const SRC = { low, medium, high, dark };
const interactive = list.length > 1;
const frames = await Promise.all(
	list.map(async (k) => ({ k, img: await getImage({ src: SRC[k], widths: [480, 760, 1080], format: 'webp' }) }))
);
---

<div class:list={['bff-thumb', className]} data-level={level} role={interactive && alt ? 'img' : undefined} aria-label={interactive && alt ? alt : undefined}>
	{
		frames.map(({ k, img }) => (
			<img
				data-frame={k}
				src={img.src}
				srcset={img.srcSet.attribute}
				sizes={sizes}
				width={SRC[k].width}
				height={SRC[k].height}
				alt={interactive ? '' : alt}
				loading="lazy"
				decoding="async"
			/>
		))
	}
</div>

<style>
	.bff-thumb {
		position: relative;
		overflow: hidden;
		border-radius: var(--bff-radius-md);
		background: var(--bff-light-night);
		aspect-ratio: 1483 / 932;
	}
	.bff-thumb img {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		opacity: 0;
		transition:
			filter 0.6s var(--bff-ease-soft),
			opacity 0.6s var(--bff-ease-soft);
	}
	.bff-thumb img:only-child,
	.bff-thumb[data-level='low'] [data-frame='low'],
	.bff-thumb[data-level='medium'] [data-frame='medium'],
	.bff-thumb[data-level='high'] [data-frame='high'],
	.bff-thumb[data-level='dark'] [data-frame='dark'] {
		opacity: 1;
	}
	.bff-thumb[data-level='dark'] img {
		filter: brightness(0.22) saturate(0.6);
	}
	@media (prefers-reduced-motion: reduce) {
		.bff-thumb img {
			transition: none;
		}
	}
</style>
