---
// Starlight's "On this page" outline with a collapse toggle on its heading row (PanelToggle.astro).
import Default from '@astrojs/starlight/components/TableOfContents.astro';
import PanelToggle from '../PanelToggle.astro';
---

{
	Astro.locals.starlightRoute.toc && (
		<div class="bff-toc">
			<PanelToggle panel="toc" />
			<div id="bff-toc-body">
				<Default />
			</div>
		</div>
	)
}

<style>
	/*
	 * Pinned to the viewport's end edge, centred in the rail the outline folds to, so the toggle stays
	 * put when the outline opens or closes. It lines up with the "On this page" heading.
	 */
	.bff-toc > :global(.bff-panel-toggle) {
		position: fixed;
		z-index: 1;
		inset-block-start: var(--bff-toggle-top);
		inset-inline-end: var(--bff-toggle-inset);
	}
</style>
