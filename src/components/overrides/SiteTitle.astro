		<circle cx="10" cy="13" r="7" fill="#ffd33d" opacity=".3"></circle>
		<circle cx="10" cy="13" r="4" fill="#ffd33d"></circle>
		<circle cx="22" cy="13" r="4" fill="#fff" opacity=".35"></circle>
	</svg>
	<span class="bff-site-title-text"><strong>Bright Factory</strong> <span>Framework</span></span>
