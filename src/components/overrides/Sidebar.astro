---
// Starlight's sidebar with a collapse toggle above it (PanelToggle.astro).
import Default from '@astrojs/starlight/components/Sidebar.astro';
import PanelToggle from '../PanelToggle.astro';
---

<PanelToggle panel="nav" />
<div id="bff-nav-body" class="bff-panel-body"><Default /></div>

<style>
	/* Transparent to the sidebar's flex layout, so Starlight's spacing is unchanged. */
	.bff-panel-body {
		display: contents;
	}
	/* Same spot as the folded rail's toggle (theme.css), so opening and closing never moves it. */
	:global(.sidebar-content) > :global(.bff-panel-toggle) {
		margin-block-start: calc(var(--bff-toggle-top) - var(--sl-nav-height) - 1rem);
		margin-inline-start: calc(var(--bff-toggle-inset) - var(--sl-sidebar-pad-x));
	}
</style>
