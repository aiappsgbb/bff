---
/**
 * One presentation slide: copy on the left, a LEGO render on the right (comp B, "room").
 * Building slides (cover, big picture, close) show the cutaway; its 3:2 image box is the
 * zoom target the page script flies into and out of. Slots: default = the slide's visual,
 * `art` = overlays positioned in % of the 3:2 image box, `copy` = replaces the copy column.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { withBase } from '../../data/site';

interface Props {
	id: string;
	index: number;
	total: number;
	zone: 'building' | 'all' | 'hq' | 'floor' | 'foundations' | 'eng';
	chapter: string;
	label: string;
	title?: string;
	lede?: string;
	href?: string;
	img: ImageMetadata;
	alt: string;
	spot?: readonly [number, number];
}

const { id, index, total, zone, chapter, label, title, lede, href, img, alt, spot } = Astro.props;
const building = zone === 'building';
---

<section
	class:list={['pz-slide', { 'is-active': index === 0, 'pz-building': building }]}
	id={id}
	role="group"
	aria-roledescription="slide"
	aria-label={`${index + 1} of ${total}: ${label}`}
	data-zone={zone}
	data-chapter={chapter}
	data-label={label}
	data-spot={spot?.join(',')}
	tabindex="-1"
>
	<div class="pz-copy">
		{
			Astro.slots.has('copy') ? (
				<slot name="copy" />
			) : (
				<>
					<h2 class="pz-h">{title}</h2>
					{lede && <p class="pz-lede">{lede}</p>}
					{Astro.slots.has('default') && (
						<div class="pz-visual">
							<slot />
						</div>
					)}
					{href && (
						<a class="pz-docs" href={withBase(href)}>
							Read the docs<span class="pz-sr">: {label}</span>
							<span aria-hidden="true">→</span>
						</a>
					)}
				</>
			)
		}
	</div>
	<div class="pz-art">
		<div class:list={['pz-imgbox', { 'pz-bimg': building }]}>
			<Image
				src={img}
				alt={alt}
				widths={[640, 960, 1280, 1536]}
				sizes="(min-aspect-ratio: 5/4) and (min-width: 48rem) 62vw, 100vw"
				loading={index === 0 ? 'eager' : 'lazy'}
				fetchpriority={index === 0 ? 'high' : undefined}
				decoding="async"
			/>
			<slot name="art" />
		</div>
	</div>
</section>
