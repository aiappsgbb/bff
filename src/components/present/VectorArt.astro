function loop() {
	const cx = 768;
	const cy = 512;
	const R = 300;
	let s = `<circle class="zs thick" cx="${cx}" cy="${cy}" r="${R}"/>`;
	for (const d of [-30, 90, 210]) {
		const [x, y] = polar(cx, cy, R, d);
		s += arrow(x, y, d + 90, 22, 'ah z');
	}
	const nodes: [number, string][] = [
		[-90, `<path class="zs" d="M-30-36V36M0-36V36M30-36V36"/><rect class="zfill" x="-40" y="-20" width="20" height="14" rx="3"/><rect class="zfill" x="-10" y="8" width="20" height="14" rx="3"/><rect class="zfill" x="20" y="-30" width="20" height="14" rx="3"/>`],
