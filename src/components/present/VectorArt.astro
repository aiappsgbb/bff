	s += `<path class="ln2" d="M672 588H864"/>`;
	s += [120, 92, 40, 104].map((h, i) => `<rect class="${i === 2 ? 'zfill' : 'barm'}" x="${684 + i * 46}" y="${582 - h}" width="34" height="${h}" rx="4"/>`).join('');
	s += `<circle class="zs" cx="${684 + 2 * 46 + 17}" cy="${582 - 40 - 34}" r="16"/>`;
	return s;
}

