---
/*
 * The animated home-page factory. The render is split into four LEGO sections
 * (foundations, floor, HQ, engineering) that click together when the scene scrolls
 * into view. Characters are sprites over a clean plate, so who works where changes
 * with the autonomy level, and every "work" animation (bff-w-*) speeds up with it.
 * All coordinates are pixels in the 1483 × 932 source render.
 */
import { getImage } from 'astro:assets';
import plate from '../assets/factory/plate.png';
import cube from '../assets/factory/cube.png';
import { withBase } from '../data/site';

const W = 1483;
const H = 932;
const ALL = 'low medium high';

const img = await getImage({ src: plate, widths: [640, 960, 1280, 1483], format: 'webp' });
const cubeImg = await getImage({ src: cube, width: 64, format: 'webp' });
const sizes = '(min-width: 72em) 52rem, 94vw';

const files = import.meta.glob<ImageMetadata>('../assets/factory/*.png', { eager: true, import: 'default' });
const asset = (k: string) => files[`../assets/factory/${k}.png`];

type Sec = 'found' | 'floor' | 'hq' | 'eng';
const SPRITES: { k: string; x: number; y: number; w: number; h: number; l: string; sec: Sec }[] = [
	{ k: 'm1', x: 175, y: 193, w: 137, h: 150, l: 'high', sec: 'hq' },
	{ k: 'm2', x: 346, y: 215, w: 116, h: 127, l: ALL, sec: 'hq' },
	{ k: 'm3', x: 554, y: 230, w: 134, h: 112, l: ALL, sec: 'hq' },
	{ k: 'm4', x: 733, y: 249, w: 125, h: 123, l: 'medium high', sec: 'hq' },
	{ k: 'm5', x: 107, y: 478, w: 145, h: 168, l: 'low', sec: 'floor' },
	{ k: 'd4', x: 239, y: 505, w: 99, h: 105, l: 'low', sec: 'floor' },
	{ k: 'c1', x: 112, y: 468, w: 170, h: 176, l: 'medium high', sec: 'floor' },
	{ k: 'c2', x: 421, y: 481, w: 135, h: 126, l: ALL, sec: 'floor' },
	{ k: 'd5', x: 533, y: 501, w: 99, h: 109, l: 'low medium', sec: 'floor' },
	{ k: 'm6', x: 741, y: 479, w: 123, h: 171, l: 'low medium', sec: 'floor' },
	{ k: 'c3', x: 747, y: 487, w: 115, h: 161, l: 'high', sec: 'floor' },
	{ k: 'd1', x: 1212, y: 351, w: 96, h: 120, l: ALL, sec: 'eng' },
	{ k: 'd3', x: 1156, y: 537, w: 118, h: 119, l: 'high', sec: 'eng' },
	{ k: 'd2', x: 1167, y: 732, w: 139, h: 122, l: 'medium high', sec: 'eng' },
];
const sprites = await Promise.all(
	SPRITES.map(async (s, i) => ({ ...s, i, src: (await getImage({ src: asset(s.k), format: 'webp' })).src }))
);
const levelsOf = (k: string) => SPRITES.find((s) => s.k === k)!.l;

const poly = (pts: number[][]) =>
	`polygon(${pts.map(([x, y]) => `${+((x / W) * 100).toFixed(3)}% ${+((y / H) * 100).toFixed(3)}%`).join(', ')})`;
// Neighbouring sections overlap by a pixel so no seam shows once assembled.
const CLIP: Record<Sec, string> = {
	found: poly([[0, 627], [57, 627], [57, 639], [985, 639], [985, 596], [1047, 596], [1047, 635], [1057, 635], [1057, 857], [1091, 857], [1091, 932], [0, 932]]),
	floor: poly([[0, 360], [988, 360], [988, 355], [1031, 355], [1031, 541], [1046, 541], [1046, 597], [984, 597], [984, 640], [58, 640], [58, 628], [0, 628]]),
	hq: poly([[0, 0], [1101, 0], [1101, 289], [1031, 289], [1031, 356], [988, 356], [988, 361], [0, 361]]),
	eng: poly([[1100, 0], [1483, 0], [1483, 932], [1090, 932], [1090, 856], [1056, 856], [1056, 636], [1045, 636], [1045, 540], [1030, 540], [1030, 288], [1100, 288]]),
};
const SEAMS = [
	'0,628 57,628 57,639 985,639 985,596 1047,596',
	'0,361 988,361 988,356 1031,356',
	'1100,0 1100,288 1030,288 1030,540 1045,540 1045,636 1056,636 1056,856 1090,856 1090,932',
];

const p = (x: number, y: number, w?: number, h?: number) =>
	`--x:${x};--y:${y}` + (w ? `;--w:${w}` : '') + (h ? `;--h:${h}` : '');

// Six belt slots; more are switched on, and they move faster, as autonomy rises.
const SLOTS = ['low medium high', 'high', 'medium high', 'low high', 'medium high', 'high'];
const ROLLERS = [256, 365, 487, 593];
const EYES: [number, number, string][] = [
	[177, 529, 'c1'], [197, 529, 'c1'], [475, 537, 'c2'], [491, 537, 'c2'], [810, 547, 'c3'], [829, 547, 'c3'],
];
const CUBE_GLOWS: [number, number, string][] = [
	[198, 573, levelsOf('c1')], [400, 539, ALL], [681, 549, ALL], [865, 579, ALL], [941, 573, ALL],
];
const NOTES: [number, number, string, string, number][] = [
	[318, 196, levelsOf('m1'), 'warm', -6],
	[452, 186, levelsOf('m2'), 'pink', 4],
	[700, 172, levelsOf('m3'), 'cool', -3],
	[742, 228, levelsOf('m4'), 'go', 7],
];
const BULBS = [[279, 167], [442, 171], [586, 163], [754, 165], [906, 167], [821, 238]];
const TANKS = [315, 396, 473, 550];
const ORBS: [number, number, string][] = [
	[458, 730, 'pink'], [621, 736, 'go'], [733, 772, 'cool'], [677, 822, 'cool'], [731, 823, 'warm'],
];
const RACKS = [
	[225, 777], [225, 802], [225, 832], [225, 852], [975, 776], [975, 801], [975, 830], [975, 855],
];
const TUBES = [1331, 1353, 1375];
const PIPES = [
	'M1114 596 V632 Q1114 654 1092 654 H1056',
	'M1138 572 V668 Q1138 691 1115 691 H1056',
	'M1148 655 V728 Q1148 750 1126 750 H1056',
];

const HOTSPOTS: { key: Sec; x: number; y: number; label: string; text: string; href: string }[] = [
	{ key: 'hq', x: 7, y: 17, label: 'Factory HQ', text: 'People bring intent, creativity, steering and judgment. Always bright.', href: '/framework/big-picture/#factory-hq' },
	{ key: 'floor', x: 7, y: 46, label: 'Factory floor', text: 'Agents do the heavy lifting. This is where the lights dim.', href: '/framework/big-picture/#factory-floor' },
	{ key: 'found', x: 7, y: 76, label: 'Foundations', text: 'Code, tools, context and identity. Stronger every loop.', href: '/framework/big-picture/#factory-foundations' },
	{ key: 'eng', x: 79, y: 24, label: 'Engineering', text: 'Tunes trust and control, expands automation, strengthens foundations.', href: '/framework/engineering/' },
];

const plateAttrs = { src: img.src, srcset: img.srcSet.attribute, sizes, width: W, height: H, decoding: 'async' as const };
const spritesIn = (sec: Sec) => sprites.filter((s) => s.sec === sec);
---

<div class="bff-factory" data-factory>
	<!-- Foundations -->
	<div class="bff-sec" data-sec="found" style={`clip-path:${CLIP.found}`}>
		<img
			class="bff-plate"
			{...plateAttrs}
			alt="A LEGO factory in cutaway that changes with the autonomy level. On the top floor, people (purple octocats) plan ideas under bright lights and post notes on the boards. On the middle floor, people, rubber ducks and robot agents work a conveyor that carries glowing code blocks into a machine; as autonomy rises, robot agents take over the floor, the lights dim and the blocks move faster. In the basement, pipes, tanks and glowing orbs form the foundations. A side building holds a quality lab where rubber ducks run tests on gauges and an oscilloscope."
			loading="eager"
			fetchpriority="high"
		/>
		<div class="bff-power" aria-hidden="true">
			{TANKS.map((x, i) => <span class="bff-p bff-c bff-gauge" style={`${p(x, 811, 24, 20)};--i:${i}`}><span /></span>)}
			{ORBS.map(([x, y, c], i) => <span class="bff-p bff-c bff-glow bff-orb" data-c={c} style={`${p(x, y, 66)};--i:${i}`} />)}
			{RACKS.map(([x, y], i) => <span class="bff-p bff-c bff-rack" style={`${p(x, y, 13, 5)};--i:${i}`} />)}
			<svg class="bff-svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
				<path class="bff-flow" d="M590 869 H333" pathLength="1" />
			</svg>
			<span class="bff-p bff-c bff-glow bff-alarm" data-c="stop" style={p(83, 698, 44)}></span>
		</div>
	</div>

	<!-- Factory floor -->
	<div class="bff-sec" data-sec="floor" style={`clip-path:${CLIP.floor}`}>
		<img class="bff-plate" {...plateAttrs} alt="" aria-hidden="true" />
		<div class="bff-floor-fx" aria-hidden="true">
			<img class="bff-plate" {...plateAttrs} alt="" />
			{ROLLERS.map((x, i) => <span class="bff-p bff-c bff-roller" style={`${p(x, 610, 19)};--i:${i}`} />)}
			{
				spritesIn('floor').map((s) => (
					<img class="bff-p bff-spr bff-lv" data-l={s.l} src={s.src} width={s.w} height={s.h} alt="" style={`${p(s.x, s.y, s.w)};--i:${s.i}`} />
				))
			}
		</div>
		<div class="bff-power" aria-hidden="true">
			<div class="bff-p bff-belt" style={p(268, 571, 350, 26)}>
				{
					SLOTS.map((l, i) => (
						<span class="bff-slot bff-lv" data-l={l} style={`--i:${i}`}>
							<img class="bff-cube" src={cubeImg.src} width="28" height="26" alt="" />
						</span>
					))
				}
			</div>
			{SLOTS.map((l, i) => <span class="bff-p bff-c bff-glow bff-intake bff-lv" data-l={l} data-c="cool" style={`${p(685, 541, 120)};--i:${i}`} />)}
			{[522, 548, 572].map((y, i) => <span class="bff-p bff-c bff-glow bff-status" data-c="go" style={`${p(106, y, 26)};--i:${i}`} />)}
			<span class="bff-p bff-c bff-glow bff-alt" data-c="stop" style={p(535, 482, 22)}></span>
			<span class="bff-p bff-c bff-glow bff-alt" data-c="go" style={`${p(558, 482, 22)};--i:1`}></span>
			<span class="bff-p bff-c bff-glow bff-pulse" data-c="stop" style={`${p(72, 568, 30)};--i:2`}></span>
			{
				[[398, 524], [868, 556]].map(([x, y], i) => (
					<svg class="bff-p bff-c bff-spark" style={`${p(x, y, 34)};--i:${i}`} viewBox="-10 -10 20 20">
						{[0, 60, 120, 180, 240, 300].map((a) => <line x1="0" y1="-3.5" x2="0" y2="-9" transform={`rotate(${a})`} />)}
						<circle r="2.2" />
					</svg>
				))
			}
			<div class="bff-leds">
				{CUBE_GLOWS.map(([x, y, l], i) => <span class="bff-p bff-c bff-glow bff-pulse bff-lv" data-l={l} data-c="violet" style={`${p(x, y, 68)};--i:${i}`} />)}
				{EYES.map(([x, y, k], i) => <span class="bff-p bff-c bff-glow bff-eye bff-lv" data-l={levelsOf(k)} data-c="eye" style={`${p(x, y, 22)};--i:${i >> 1}`} />)}
			</div>
		</div>
	</div>

	<!-- Factory HQ -->
	<div class="bff-sec" data-sec="hq" style={`clip-path:${CLIP.hq}`}>
		<img class="bff-plate" {...plateAttrs} alt="" aria-hidden="true" />
		{
			spritesIn('hq').map((s) => (
				<img class="bff-p bff-spr bff-lv" data-l={s.l} src={s.src} width={s.w} height={s.h} alt="" aria-hidden="true" style={`${p(s.x, s.y, s.w)};--i:${s.i}`} />
			))
		}
		<div class="bff-hq-glow" aria-hidden="true"></div>
		<div class="bff-power" aria-hidden="true">
			{BULBS.map(([x, y], i) => <span class="bff-p bff-c bff-glow bff-bulb" data-c="warm" style={`${p(x, y, 58)};--i:${i}`} />)}
			<span class="bff-p bff-c bff-glow bff-idea" data-c="warm" style={p(529, 244, 120)}></span>
			<span class="bff-p bff-c bff-glow bff-pulse" data-c="violet" style={`${p(521, 312, 64)};--i:1`}></span>
			{NOTES.map(([x, y, l, c, r], i) => <span class="bff-lv bff-note-slot" data-l={l}><span class="bff-p bff-c bff-note" data-c={c} style={`${p(x, y, 15)};--r:${r}deg;--i:${i}`} /></span>)}
		</div>
	</div>

	<!-- Engineering -->
	<div class="bff-sec" data-sec="eng" style={`clip-path:${CLIP.eng}`}>
		<img class="bff-plate" {...plateAttrs} alt="" aria-hidden="true" />
		{
			spritesIn('eng').map((s) => (
				<img class="bff-p bff-spr bff-lv" data-l={s.l} src={s.src} width={s.w} height={s.h} alt="" aria-hidden="true" style={`${p(s.x, s.y, s.w)};--i:${s.i}`} />
			))
		}
		<div class="bff-power" aria-hidden="true">
			<div class="bff-p bff-scope" style={p(1190, 528, 62, 39)}>
				<svg viewBox="0 0 124 39" preserveAspectRatio="none"><path d="M0 19.5 q7.75 -13 15.5 0 t15.5 0 t15.5 0 t15.5 0 t15.5 0 t15.5 0 t15.5 0 t15.5 0" /></svg>
			</div>
			<span class="bff-p bff-c bff-glow bff-zap" data-c="violet" style={p(1412, 525, 86)}></span>
			{
				TUBES.flatMap((x, t) =>
					[0, 1].map((b) => <span class="bff-p bff-c bff-bubble" style={`${p(x + (b ? 2 : -2), 438, 7)};--i:${t * 2 + b}`} />)
				)
			}
			<span class="bff-lv" data-l={levelsOf('d2')}><span class="bff-p bff-laser" style={p(1308, 766, 64, 3)}></span></span>
			<span class="bff-lv" data-l={levelsOf('d3')}>
				<span class="bff-p bff-c bff-glow bff-pulse" data-c="violet" style={`${p(1321, 588, 84)};--i:3`}></span>
				<span class="bff-p bff-c bff-glow bff-alt" data-c="stop" style={`${p(1253, 591, 20)};--i:1`}></span>
			</span>
			<img class="bff-p bff-packet" src={cubeImg.src} width="18" height="17" alt="" style={p(1028, 333, 18)} />
			<svg class="bff-svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
				{PIPES.map((d, i) => <path class="bff-flow" d={d} pathLength="1" style={`--i:${i}`} />)}
			</svg>
		</div>
	</div>

	<svg class="bff-seams" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
		{SEAMS.map((pts, i) => <polyline points={pts} pathLength="1" style={`--i:${i}`} />)}
	</svg>

	{
		HOTSPOTS.map((h) => (
			<div class="bff-hot" data-sec={h.key}>
				<a class="bff-hotspot" data-key={h.key} href={withBase(h.href)} style={`--x:${h.x}%;--y:${h.y}%`}>
					<span class="bff-hotspot-dot" aria-hidden="true" />
					<span class="bff-hotspot-label">{h.label}</span>
					<span class="bff-hotspot-text">{h.text}</span>
				</a>
			</div>
		))
	}
</div>
<script is:inline>
	// Runs before first paint: hide the sections only when they will animate in, so
	// the factory stays assembled without JavaScript or with reduced motion.
	(() => {
		const f = document.currentScript && document.currentScript.previousElementSibling;
		if (!f || !('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		f.dataset.asm = 'pending';
		const io = new IntersectionObserver(
			(entries) => {
				if (!entries.some((e) => e.isIntersecting)) return;
				io.disconnect();
				f.dataset.asm = 'run';
				setTimeout(() => (f.dataset.asm = 'done'), 2400);
			},
			{ threshold: 0.35 }
		);
		io.observe(f);
	})();
</script>

<script>
	// Work animations speed up with autonomy; the rate eases between levels so the
	// floor visibly spins up or winds down. Off-screen, everything pauses.
	const RATE: Record<string, number> = { low: 0.55, medium: 1, high: 1.8 };

	document.querySelectorAll<HTMLElement>('[data-factory]').forEach((fig) => {
		const host = fig.closest<HTMLElement>('.bff-hero');
		const work = () =>
			fig.getAnimations({ subtree: true }).filter((a) => (a as CSSAnimation).animationName?.startsWith('bff-w-'));
		let rate = 1;
		let raf = 0;
		const setRate = (r: number) => {
			rate = r;
			work().forEach((a) => (a.playbackRate = r));
		};
		const ramp = (target: number) => {
			cancelAnimationFrame(raf);
			const from = rate;
			const t0 = performance.now();
			const step = (t: number) => {
				const k = Math.min(1, (t - t0) / 700);
				setRate(from + (target - from) * (1 - (1 - k) ** 3));
				if (k < 1) raf = requestAnimationFrame(step);
			};
			raf = requestAnimationFrame(step);
		};
		const target = () => RATE[host?.dataset.level ?? 'medium'] ?? 1;
		setRate(target());
		if (host) new MutationObserver(() => ramp(target())).observe(host, { attributes: true, attributeFilter: ['data-level'] });
		new IntersectionObserver(([e]) => fig.toggleAttribute('data-idle', !e.isIntersecting)).observe(fig);
	});
</script>

<style>
	.bff-factory {
		--floor-filter: brightness(1) saturate(1);
		--led: 0.55;
		--ease-click: cubic-bezier(0.3, 1.45, 0.55, 1);
		position: relative;
		aspect-ratio: 1483 / 932;
	}
	:global(.bff-hero[data-level='low']) .bff-factory {
		--floor-filter: brightness(1.75) saturate(0.85);
		--led: 0;
	}
	:global(.bff-hero[data-level='high']) .bff-factory {
		--floor-filter: brightness(0.38) saturate(0.9);
		--led: 1;
	}

	.bff-sec,
	.bff-hot,
	.bff-floor-fx,
	.bff-power,
	.bff-leds,
	.bff-svg,
	.bff-seams {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	.bff-plate {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		user-select: none;
	}
	/* Second copy of the render, clipped to the floor interior, carries the dimming filter. */
	.bff-floor-fx {
		clip-path: inset(42.06% 32.57% 31.33% 5.93%);
		filter: var(--floor-filter);
		transition: filter 0.7s var(--bff-ease-soft);
	}

	/* Everything placed by source pixel. */
	.bff-p {
		position: absolute;
		left: calc(var(--x) * 100% / 1483);
		top: calc(var(--y) * 100% / 932);
		width: calc(var(--w, 10) * 100% / 1483);
	}
	.bff-c {
		translate: -50% -50%;
		aspect-ratio: 1;
	}

	/* Who is on shift depends on the level. */
	.bff-lv {
		opacity: 0;
		transition: opacity 0.3s var(--bff-ease-soft);
	}
	:global(.bff-hero[data-level='low']) .bff-lv[data-l~='low'],
	:global(.bff-hero[data-level='medium']) .bff-lv[data-l~='medium'],
	:global(.bff-hero[data-level='high']) .bff-lv[data-l~='high'] {
		opacity: 1;
		transition-delay: 0.15s;
	}
	.bff-spr {
		height: auto;
		transform-origin: 50% 100%;
		scale: 0.9;
		translate: 0 -4%;
		transition:
			opacity 0.3s var(--bff-ease-soft),
			scale 0.3s var(--bff-ease-soft),
			translate 0.3s var(--bff-ease-soft);
		animation: bff-idle calc(2.4s + var(--i) * 0.13s) calc(var(--i) * -0.7s) ease-in-out infinite alternate;
	}
	:global(.bff-hero[data-level='low']) .bff-spr[data-l~='low'],
	:global(.bff-hero[data-level='medium']) .bff-spr[data-l~='medium'],
	:global(.bff-hero[data-level='high']) .bff-spr[data-l~='high'] {
		scale: 1;
		translate: 0 0;
		transition:
			opacity 0.35s 0.15s var(--bff-ease-soft),
			scale 0.55s 0.15s var(--ease-click),
			translate 0.55s 0.15s var(--ease-click);
	}
	@keyframes bff-idle {
		from { transform: none; }
		to { transform: translateY(-1.2%) scaleY(1.012); }
	}

	/* Glows (light on top of the render). */
	.bff-glow {
		border-radius: 50%;
		mix-blend-mode: screen;
		background: radial-gradient(closest-side, var(--g) 0, color-mix(in srgb, var(--g) 45%, transparent) 40%, transparent);
	}
	[data-c='warm'] { --g: var(--bff-light-warm); }
	[data-c='cool'] { --g: var(--bff-light-cool); }
	[data-c='violet'] { --g: var(--bff-light-violet); }
	[data-c='go'] { --g: var(--bff-light-go); }
	[data-c='stop'] { --g: var(--bff-light-stop); }
	[data-c='pink'] { --g: var(--bff-light-pink); }
	[data-c='eye'] {
		background: radial-gradient(closest-side, var(--bff-light-core), color-mix(in srgb, var(--bff-light-cool) 70%, transparent) 40%, transparent);
	}
	.bff-leds {
		opacity: var(--led);
		transition: opacity 0.7s var(--bff-ease-soft);
	}
	.bff-pulse {
		animation: bff-w-pulse 2.8s calc(var(--i, 0) * -0.45s) var(--bff-ease-soft) infinite alternate;
	}
