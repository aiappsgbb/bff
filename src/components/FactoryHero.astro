---
import Eyebrow from './Eyebrow.astro';
import FactoryScene from './FactoryScene.astro';
import { LEVELS, LEVEL_ORDER, withBase } from '../data/site';
---

<section class="bff-hero not-content" data-level="medium" aria-labelledby="bff-hero-title">
	<div class="bff-hero-copy">
		<Eyebrow text="bright-factory.init()" accent="green" />
		<p class="bff-hero-title" id="bff-hero-title">Bright Factory <span>Framework</span></p>
		<p class="bff-hero-sub">Microsoft opinionated framework for building agentic software factories.</p>
		<p class="bff-hero-lede">
			Ideas come to life. Agents do the heavy lifting. Humans monitor and control, with the lights on where it
			matters. <a href={withBase('/fundamentals/')}>What is a software factory?</a>
		</p>
		<div class="bff-hero-ctas">
			<a class="bff-btn bff-btn-primary" href={withBase('/get-started/')}>Get started <span aria-hidden="true">→</span></a>
			<a class="bff-btn" href={withBase('/get-started/find-your-level/')}>Find your level</a>
		</div>
		<a class="bff-hero-present" href={withBase('/present/')}>
			<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M4.5 2.9v10.2a.6.6 0 0 0 .9.5l8-5.1a.6.6 0 0 0 0-1l-8-5.1a.6.6 0 0 0-.9.5Z" /></svg>
			Present the framework
		</a>
	</div>

	<div class="bff-stage">
		<fieldset class="bff-dimmer" data-hint>
			<legend class="sr-only">Autonomy dimmer: choose an autonomy level</legend>
			<div class="bff-dimmer-head" aria-hidden="true">
				<span class="bff-mono bff-dimmer-label">autonomy.dimmer</span>
				<span class="bff-dimmer-hint">
					<svg class="bff-dimmer-hint-arrows" viewBox="0 0 24 12" width="22" height="11">
						<path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M5 2 1 6l4 4M1 6h22M19 2l4 4-4 4"></path>
					</svg>
					Slide to change autonomy
				</span>
			</div>
			<div class="bff-dimmer-plate">
				<div class="bff-dimmer-track" aria-hidden="true">
					<span class="bff-dimmer-ticks"><i></i><i></i><i></i></span>
					<span class="bff-dimmer-knob"></span>
				</div>
				<div class="bff-dimmer-stops">
					{
						LEVEL_ORDER.map((k) => (
							<label class="bff-dimmer-stop" data-stop={k}>
								<input type="radio" name="bff-level" value={k} checked={k === 'medium'} />
								<span class="name">{LEVELS[k].name.replace(' autonomy', '')}<span class="sr-only"> autonomy</span></span>
							</label>
						))
					}
				</div>
			</div>
		</fieldset>

		<FactoryScene />

		<div class="bff-dimmer-panel">
			<div class="bff-readouts">
				{
					LEVEL_ORDER.map((k) => {
						const l = LEVELS[k];
						return (
							<div class="bff-readout" data-for={k}>
								<p class="bff-readout-tag">{l.tagline}</p>
								<dl>
									<div><dt>People</dt><dd>{l.people}</dd></div>
									<div><dt>Agents</dt><dd>{l.agents}</dd></div>
									<div><dt>Approvals</dt><dd>{l.approvals}</dd></div>
								</dl>
								<p class="bff-readout-links">
									<a href={withBase(`/levels/${k}/`)}>{l.name} <span aria-hidden="true">→</span></a>
									<a href={withBase(`/playbooks/${k}/`)}>Playbook <span aria-hidden="true">→</span></a>
								</p>
							</div>
						);
					})
				}
			</div>

			<div class="bff-undo-row">
				<button type="button" class="bff-btn bff-btn-small bff-undo" data-undo>
					<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M1.5 8a.75.75 0 0 1 .22-.53l3-3a.75.75 0 0 1 1.06 1.06L4.06 7.25h8.19a.75.75 0 0 1 0 1.5H4.06l1.72 1.72a.75.75 0 0 1-1.06 1.06l-3-3A.75.75 0 0 1 1.5 8Z"></path></svg>
					<span>Dim back up<span data-undo-to> to Low</span></span>
				</button>
				<p class="bff-undo-note" data-undo-note>Reversible by design: any work type can dim back up to keep the business running.</p>
			</div>
			<p class="sr-only" aria-live="polite" data-live></p>
		</div>
	</div>
</section>

<script>
	import { LEVELS } from '../data/site';
	type Level = 'low' | 'medium' | 'high';
	const ORDER: Level[] = ['low', 'medium', 'high'];
	const KEY = 'bff-level';
	const HINT_KEY = 'bff-dimmer-hinted';

	document.querySelectorAll<HTMLElement>('.bff-hero').forEach((hero) => {
		const radios = [...hero.querySelectorAll<HTMLInputElement>('input[name="bff-level"]')];
		const dimmer = hero.querySelector<HTMLElement>('.bff-dimmer')!;
		const plate = hero.querySelector<HTMLElement>('.bff-dimmer-plate')!;
		const live = hero.querySelector<HTMLElement>('[data-live]')!;
		const note = hero.querySelector<HTMLElement>('[data-undo-note]')!;
		const undo = hero.querySelector<HTMLButtonElement>('[data-undo]')!;
		const undoTo = hero.querySelector<HTMLElement>('[data-undo-to]')!;
		const defaultNote = note.textContent;
		const short = (l: Level) => LEVELS[l].name.replace(' autonomy', '');

		try { if (localStorage.getItem(HINT_KEY)) delete dimmer.dataset.hint; } catch {}
		const dismissHint = () => {
			if (!('hint' in dimmer.dataset)) return;
			delete dimmer.dataset.hint;
			try { localStorage.setItem(HINT_KEY, '1'); } catch {}
		};

		const apply = (level: Level, { announce = true, persist = true } = {}) => {
			hero.dataset.level = level;
			radios.forEach((r) => (r.checked = r.value === level));
			const below = ORDER[ORDER.indexOf(level) - 1];
			// aria-disabled rather than disabled, so keyboard focus stays put after dimming to Low.
			undo.setAttribute('aria-disabled', String(!below));
			undoTo.textContent = below ? ` to ${short(below)}` : '';
			if (persist) {
				try { localStorage.setItem(KEY, level); } catch {}
			}
			if (announce) live.textContent = `${LEVELS[level].name}: ${LEVELS[level].tagline}`;
			window.dispatchEvent(new CustomEvent('bff:level', { detail: level }));
		};

		// A shared ?level= link still sets the level; it is saved and then dropped from
		// the address so the URL never goes stale as the reader moves the dimmer.
		const url = new URL(location.href);
		const fromUrl = url.searchParams.get('level') as Level | null;
		let stored: Level | null = null;
		try { stored = localStorage.getItem(KEY) as Level | null; } catch {}
		const initial = [fromUrl, stored].find((l): l is Level => !!l && ORDER.includes(l)) ?? 'medium';
		apply(initial, { announce: false, persist: !!fromUrl });
		if (url.searchParams.has('level')) {
			url.searchParams.delete('level');
			history.replaceState(history.state, '', url);
		}

		const choose = (level: Level) => {
			dismissHint();
			if (level === hero.dataset.level) return;
			note.textContent = defaultNote;
			apply(level);
		};

		radios.forEach((r) => r.addEventListener('change', () => choose(r.value as Level)));

		// Drag along the plate to slide between stops; touch keeps vertical scrolling.
		const stopAt = (x: number): Level => {
			const r = plate.getBoundingClientRect();
			const i = Math.floor(((x - r.left) / r.width) * ORDER.length);
			return ORDER[Math.min(ORDER.length - 1, Math.max(0, i))];
		};
		let dragging = false;
		plate.addEventListener('pointerdown', (e) => {
			if (e.button !== 0) return;
			dragging = true;
			plate.setPointerCapture(e.pointerId);
			choose(stopAt(e.clientX));
		});
		plate.addEventListener('pointermove', (e) => {
			if (dragging) choose(stopAt(e.clientX));
		});
		const endDrag = () => {
			dragging = false;
		};
		plate.addEventListener('pointerup', endDrag);
		plate.addEventListener('pointercancel', endDrag);

		undo.addEventListener('click', () => {
			dismissHint();
			const idx = ORDER.indexOf(hero.dataset.level as Level);
			if (idx <= 0) return;
			const next = ORDER[idx - 1];
			apply(next, { announce: false });
			hero.classList.remove('bff-incident');
			void hero.offsetWidth;
			hero.classList.add('bff-incident');
			const msg = `Dimmed back up to ${LEVELS[next].name}. Approvals return to people and work continues from the issues, pull requests and specs in Git.`;
			note.textContent = msg;
			live.textContent = msg;
		});
	});
</script>

<style>
	.bff-hero {
		--knob-x: 50%;
		display: grid;
		gap: clamp(1.5rem, 4vw, 3.5rem);
		padding-block: clamp(1rem, 3vw, 2.5rem) clamp(2rem, 5vw, 4rem);
	}
	/* Desktop: copy on the left, the dimmer and the factory it controls on the right,
	   so both sit in the first viewport. */
	@media (min-width: 64em) {
		.bff-hero {
			grid-template-columns: minmax(0, 25rem) minmax(0, 1fr);
			align-items: center;
		}
	}
	/* Stops are equal columns with a 0.5rem gap, so their centres sit at these offsets. */
	.bff-hero[data-level='low'] {
		--knob-x: calc((100% - 1rem) / 6);
	}
	.bff-hero[data-level='high'] {
		--knob-x: calc(100% - (100% - 1rem) / 6);
	}

	/* Copy */
	.bff-hero-copy {
		max-width: 52rem;
		container-type: inline-size;
	}
	.bff-hero-title {
		margin: 0.75rem 0 0;
		/* Capped by the copy column so "Bright Factory" stays on one line beside the stage. */
		font-size: min(var(--bff-text-display), 15cqi);
		line-height: 1.02;
		font-weight: 500;
		font-variation-settings: 'wdth' 112;
		letter-spacing: -0.025em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
	.bff-hero-title span {
		color: var(--sl-color-accent);
	}
	.bff-hero-sub {
		margin: 1rem 0 0;
		font-size: var(--bff-text-lede);
		line-height: 1.3;
		color: var(--sl-color-gray-2);
		font-weight: 450;
		text-wrap: balance;
	}
	.bff-hero-lede {
		margin: 0.75rem 0 0;
		max-width: 40rem;
		font-size: var(--bff-text-lg);
		color: var(--sl-color-gray-3);
	}
	.bff-hero-lede a {
		color: var(--sl-color-accent-high);
		font-weight: 600;
		text-underline-offset: 0.2em;
	}
	.bff-hero-lede a:hover {
		color: var(--sl-color-white);
	}
	.bff-hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
	.bff-hero-present {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		margin-top: 0.5rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
	}
	.bff-hero-present svg {
		color: var(--sl-color-accent-high);
	}
	.bff-hero-present:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	@media (min-width: 64em) {
		.bff-hero-sub {
			font-size: var(--bff-text-xl);
		}
	}

	/* Stage. Clipping inline overflow keeps the engineering block's slide-in from
	   widening the page before the factory assembles. */
	.bff-stage {
		container-type: inline-size;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
		padding: clamp(0.75rem, 2vw, 1.25rem);
		overflow-x: clip;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--bff-radius);
		background:
			radial-gradient(120% 90% at 30% 10%, color-mix(in srgb, var(--bff-light-warm) 10%, transparent), transparent 60%),
			var(--bff-surface);
	}

	/* Dimmer: a horizontal slider above the factory it controls. */
	.bff-dimmer-panel {
		display: grid;
		gap: 1rem;
	}
	.bff-dimmer {
		position: relative;
		z-index: 1;
		border: 0;
		padding: 0;
		margin: 0;
		min-width: 0;
	}
	.bff-dimmer-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		margin-bottom: 0.6rem;
		font-size: var(--bff-text-xs);
		color: var(--sl-color-gray-3);
	}
	.bff-dimmer-hint {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.2rem 0.7rem 0.2rem 0.55rem;
		border-radius: var(--bff-radius-pill);
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
		font-weight: 600;
		transition:
			opacity 0.35s var(--bff-ease-soft),
			visibility 0s linear 0.35s;
	}
	.bff-dimmer-hint-arrows {
		flex: none;
		animation: bff-hint-arrows 2.4s var(--bff-ease-soft) 2.2s 3 both;
	}
	.bff-dimmer:not([data-hint]) .bff-dimmer-hint {
		opacity: 0;
		visibility: hidden;
	}
	@media (max-width: 40em) {
		.bff-dimmer-label {
			display: none;
		}
	}

	.bff-dimmer-plate {
		display: grid;
		gap: 0.35rem;
		padding: 0.85rem 0.75rem 0.5rem;
		border-radius: var(--bff-radius-md);
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-hairline);
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
	}
	.bff-dimmer-track {
		position: relative;
		height: 2rem;
		cursor: grab;
	}
	.bff-dimmer-track::before {
		content: '';
		position: absolute;
		inset: 50% 0 auto;
		height: 0.7rem;
		transform: translateY(-50%);
		border-radius: var(--bff-radius-pill);
		background: linear-gradient(to right, var(--bff-light-warm), var(--bff-green) 50%, var(--bff-light-night));
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sl-color-white) 8%, transparent);
	}
	.bff-dimmer-ticks i {
		position: absolute;
		top: 50%;
		width: 0.3rem;
		height: 0.3rem;
		border-radius: 50%;
		background: color-mix(in srgb, var(--bff-brick-white) 75%, transparent);
		transform: translate(-50%, -50%);
	}
	.bff-dimmer-ticks i:nth-child(1) { left: calc((100% - 1rem) / 6); }
	.bff-dimmer-ticks i:nth-child(2) { left: 50%; }
	.bff-dimmer-ticks i:nth-child(3) { left: calc(100% - (100% - 1rem) / 6); }
	.bff-dimmer-knob {
		position: absolute;
		top: 50%;
		left: var(--knob-x);
		width: 2.75rem;
		height: 1.6rem;
		border-radius: var(--bff-radius-sm);
		background: var(--bff-brick-white);
		box-shadow:
			0 2px 0 var(--bff-brick-shade),
			var(--bff-shadow-sm);
		transform: translate(-50%, -45%);
		/* Outlines the brick and its studs together so it reads on a light plate. */
		filter: drop-shadow(0 0 0.6px color-mix(in srgb, var(--bff-shadow-ink) 55%, transparent));
		transition: left 0.55s var(--bff-ease-out);
	}
	.bff-dimmer[data-hint] .bff-dimmer-knob {
		animation: bff-knob-nudge 2.4s var(--bff-ease-soft) 2.2s 3 both;
	}
	/* Two LEGO studs on the knob. */
	.bff-dimmer-knob::before,
	.bff-dimmer-knob::after {
		content: '';
		position: absolute;
		top: -5px;
		width: 0.8rem;
		height: 0.45rem;
		border-radius: 3px 3px 0 0;
		background: var(--bff-brick-white);
		box-shadow: inset 0 -1px 0 var(--bff-brick-shade);
	}
	.bff-dimmer-knob::before { left: 0.35rem; }
	.bff-dimmer-knob::after { right: 0.35rem; }

	/* The hint: the knob nudges along the track while the arrows sway in step. */
	@keyframes bff-knob-nudge {
		0%, 50%, 100% { translate: 0 0; }
		14% { translate: 0.9rem 0; }
		30% { translate: -0.6rem 0; }
	}
	@keyframes bff-hint-arrows {
		/* transform, not translate: the compositor only animates an <svg>'s transform. */
		0%, 50%, 100% { transform: none; }
		14% { transform: translateX(3px); }
		30% { transform: translateX(-2px); }
	}
	@media (prefers-reduced-motion: reduce) {
		.bff-dimmer-knob,
		.bff-dimmer-hint {
			transition: none;
		}
		.bff-dimmer[data-hint] .bff-dimmer-knob,
		.bff-dimmer-hint-arrows {
			animation: none;
		}
	}
	/* The hint waits while the reader is away from the hero (the factory is idle). */
	.bff-hero:has(.bff-factory[data-idle]) :is(.bff-dimmer-knob, .bff-dimmer-hint-arrows) {
		animation-play-state: paused;
	}

	.bff-dimmer-stops {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.5rem;
	}
	.bff-dimmer-stop {
		position: relative;
		display: grid;
		justify-items: center;
		align-content: center;
		min-height: 2.75rem;
		padding: 0.35rem 0.5rem;
		border-radius: var(--bff-radius-sm);
		text-align: center;
		cursor: pointer;
		transition: background-color 0.2s var(--bff-ease-soft);
	}
	.bff-dimmer-stop:hover {
		background: var(--bff-surface-2);
	}
	.bff-dimmer-stop input {
		position: absolute;
		opacity: 0;
		inset: 0;
		margin: 0;
		cursor: pointer;
	}
	.bff-dimmer-stop:has(input:focus-visible) {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 1px;
	}
	.bff-dimmer-stop .name {
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.bff-dimmer-stop:has(input:checked) {
		background: var(--sl-color-accent-low);
	}
	.bff-dimmer-stop:has(input:checked) .name {
		color: var(--sl-color-accent-high);
	}

	/* Readouts */
	.bff-readout {
		display: none;
	}
	.bff-hero[data-level='low'] .bff-readout[data-for='low'],
	.bff-hero[data-level='medium'] .bff-readout[data-for='medium'],
	.bff-hero[data-level='high'] .bff-readout[data-for='high'] {
		display: block;
		animation: bff-fade-up 0.45s var(--bff-ease-out);
	}
	@keyframes bff-fade-up {
		from { opacity: 0; transform: translateY(6px); }
		to { opacity: 1; transform: none; }
	}
	.bff-readout-tag {
		margin: 0 0 0.75rem;
		font-size: var(--bff-text-lg);
		font-weight: 560;
		line-height: 1.35;
		color: var(--sl-color-white);
	}
	.bff-readout dl {
		display: grid;
		gap: 0.4rem;
		margin: 0;
		font-size: var(--bff-text-sm);
	}
	.bff-readout dl > div {
		display: grid;
		grid-template-columns: 5.5rem 1fr;
		gap: 0.5rem;
	}
	.bff-readout dt {
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-2xs);
		color: var(--sl-color-gray-3);
		padding-top: 0.1rem;
	}
	.bff-readout dd {
		margin: 0;
		color: var(--sl-color-gray-2);
	}
	.bff-readout-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin: 0.9rem 0 0;
		font-size: var(--bff-text-sm);
		font-weight: 600;
	}
	.bff-readout-links a {
		color: var(--sl-color-accent-high);
		text-decoration: none;
	}
	.bff-readout-links a:hover {
		text-decoration: underline;
	}

	.bff-undo-row {
		display: grid;
		gap: 0.5rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.bff-undo {
		justify-self: start;
	}
	.bff-undo[aria-disabled='true'] {
		opacity: 0.45;
		cursor: not-allowed;
		transform: none;
	}
	.bff-undo-note {
		margin: 0;
		font-size: var(--bff-text-xs);
		color: var(--sl-color-gray-3);
	}
	/* A wide stage puts the readout and the undo control side by side under the factory. */
	@container (min-width: 36rem) {
		.bff-dimmer-panel {
			grid-template-columns: minmax(0, 1fr) minmax(0, 13.5rem);
			column-gap: 1.25rem;
			align-items: start;
		}
		.bff-undo-row {
			padding-top: 0;
			padding-inline-start: 1.25rem;
			border-top: 0;
			border-inline-start: 1px solid var(--sl-color-hairline);
		}
	}
</style>
