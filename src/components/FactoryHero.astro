---
import Eyebrow from './Eyebrow.astro';
import FactoryScene from './FactoryScene.astro';
import { LEVELS, LEVEL_ORDER, withBase } from '../data/site';
---

<section class="bff-hero not-content" data-level="medium" aria-labelledby="bff-hero-title">
	<div class="bff-hero-copy">
		<Eyebrow text="bright-factory.init()" accent="green" />
		<p class="bff-hero-title" id="bff-hero-title">Bright Factory <span>Framework</span></p>
		<p class="bff-hero-sub">Microsoft opinionated framework for building agentic software factories.</p>
		<p class="bff-hero-lede">
			Ideas come to life. Agents do the heavy lifting. Humans monitor and control, with the lights on where it
			matters.
		</p>
		<div class="bff-hero-ctas">
			<a class="bff-btn bff-btn-primary" href={withBase('/get-started/')}>Get started <span aria-hidden="true">→</span></a>
			<a class="bff-btn" href={withBase('/get-started/find-your-level/')}>Find your level</a>
			<a class="bff-btn bff-btn-ghost" href={withBase('/fundamentals/')}>What is a software factory?</a>
		</div>
	</div>

	<div class="bff-stage">
		<FactoryScene />

		<div class="bff-dimmer-panel">
			<fieldset class="bff-dimmer">
				<legend><span class="bff-mono">autonomy.dimmer</span><span class="sr-only">: choose an autonomy level</span></legend>
				<div class="bff-dimmer-plate">
					<div class="bff-dimmer-track" aria-hidden="true"><span class="bff-dimmer-knob"></span></div>
					<div class="bff-dimmer-stops">
						{
							LEVEL_ORDER.map((k) => (
								<label class="bff-dimmer-stop" data-stop={k}>
									<input type="radio" name="bff-level" value={k} checked={k === 'medium'} />
									<span class="name">{LEVELS[k].name.replace(' autonomy', '')}</span>
									<span class="gait">{LEVELS[k].gait} · {LEVELS[k].floor.toLowerCase()}</span>
								</label>
							))
						}
					</div>
				</div>
			</fieldset>

			<div class="bff-readouts">
				{
					LEVEL_ORDER.map((k) => {
						const l = LEVELS[k];
						return (
							<div class="bff-readout" data-for={k}>
								<p class="bff-readout-tag">{l.tagline}</p>
								<dl>
									<div><dt>People</dt><dd>{l.people}</dd></div>
									<div><dt>Agents</dt><dd>{l.agents}</dd></div>
									<div><dt>Approvals</dt><dd>{l.approvals}</dd></div>
									<div><dt>Mode</dt><dd><span class="bff-pill">{l.mode}</span></dd></div>
								</dl>
								<p class="bff-readout-links">
									<a href={withBase(`/levels/${k}/`)}>{l.name} <span aria-hidden="true">→</span></a>
									<a href={withBase(`/playbooks/${k}/`)}>Playbook <span aria-hidden="true">→</span></a>
								</p>
							</div>
						);
					})
				}
			</div>

			<div class="bff-undo-row">
				<button type="button" class="bff-btn bff-btn-small bff-undo" data-undo>
					<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 1.5a.75.75 0 0 1 .53.22l3 3a.75.75 0 0 1-1.06 1.06L8.75 4.06v8.19a.75.75 0 0 1-1.5 0V4.06L5.53 5.78a.75.75 0 0 1-1.06-1.06l3-3A.75.75 0 0 1 8 1.5Z"></path></svg>
					Dim back up
				</button>
				<p class="bff-undo-note" data-undo-note>Reversible by design: any work type can dim back up to keep the business running.</p>
			</div>
			<p class="sr-only" aria-live="polite" data-live></p>
		</div>
	</div>
</section>

<script>
	import { LEVELS } from '../data/site';
	type Level = 'low' | 'medium' | 'high';
	const ORDER: Level[] = ['low', 'medium', 'high'];
	const KEY = 'bff-level';

	document.querySelectorAll<HTMLElement>('.bff-hero').forEach((hero) => {
		const radios = [...hero.querySelectorAll<HTMLInputElement>('input[name="bff-level"]')];
		const live = hero.querySelector<HTMLElement>('[data-live]')!;
		const note = hero.querySelector<HTMLElement>('[data-undo-note]')!;
		const undo = hero.querySelector<HTMLButtonElement>('[data-undo]')!;
		const defaultNote = note.textContent;

		const apply = (level: Level, { announce = true, persist = true } = {}) => {
			hero.dataset.level = level;
			radios.forEach((r) => (r.checked = r.value === level));
			undo.disabled = level === 'low';
			if (persist) {
				try { localStorage.setItem(KEY, level); } catch {}
				const url = new URL(location.href);
				url.searchParams.set('level', level);
				history.replaceState(null, '', url);
			}
			if (announce) live.textContent = `${LEVELS[level].name}: ${LEVELS[level].tagline}`;
			window.dispatchEvent(new CustomEvent('bff:level', { detail: level }));
		};

		const fromUrl = new URL(location.href).searchParams.get('level') as Level | null;
		let stored: Level | null = null;
		try { stored = localStorage.getItem(KEY) as Level | null; } catch {}
		const initial = [fromUrl, stored].find((l): l is Level => !!l && ORDER.includes(l)) ?? 'medium';
		apply(initial, { announce: false, persist: !!fromUrl });

		radios.forEach((r) =>
			r.addEventListener('change', () => {
				note.textContent = defaultNote;
				apply(r.value as Level);
			})
		);

		undo.addEventListener('click', () => {
			const idx = ORDER.indexOf(hero.dataset.level as Level);
			if (idx <= 0) return;
			const next = ORDER[idx - 1];
			apply(next, { announce: false });
			hero.classList.remove('bff-incident');
			void hero.offsetWidth;
			hero.classList.add('bff-incident');
			const msg = `Dimmed back up to ${LEVELS[next].name.toLowerCase()}. Approvals return to people and work continues from the issues, pull requests and specs in Git.`;
			note.textContent = msg;
			live.textContent = msg;
		});
	});
</script>

<style>
	.bff-hero {
		--knob-top: 50%;
		display: grid;
		gap: clamp(2rem, 4vw, 3.5rem);
		padding-block: clamp(1rem, 3vw, 2.5rem) clamp(2rem, 5vw, 4rem);
	}
	/* Stops are equal rows with a 0.5rem gap, so their centres sit at these offsets. */
	.bff-hero[data-level='low'] {
		--knob-top: calc((100% - 1rem) / 6);
	}
	.bff-hero[data-level='high'] {
		--knob-top: calc(100% - (100% - 1rem) / 6);
	}

	/* Copy */
	.bff-hero-copy {
		max-width: 52rem;
	}
	.bff-hero-title {
		margin: 0.75rem 0 0;
		font-size: var(--bff-text-display);
		line-height: 1.02;
		font-weight: 500;
		font-variation-settings: 'wdth' 112;
		letter-spacing: -0.025em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
	.bff-hero-title span {
		color: var(--sl-color-accent);
	}
	.bff-hero-sub {
		margin: 1rem 0 0;
		font-size: var(--bff-text-lede);
		line-height: 1.3;
		color: var(--sl-color-gray-2);
		font-weight: 450;
		text-wrap: balance;
	}
	.bff-hero-lede {
		margin: 0.75rem 0 0;
		max-width: 40rem;
		font-size: var(--bff-text-lg);
		color: var(--sl-color-gray-3);
	}
	.bff-hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	/* Stage */
	.bff-stage {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.25rem;
		padding: clamp(0.75rem, 2vw, 1.5rem);
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--bff-radius);
		background:
			radial-gradient(120% 90% at 30% 10%, color-mix(in srgb, var(--bff-light-warm) 10%, transparent), transparent 60%),
			var(--bff-surface);
	}
	@media (min-width: 64em) {
		.bff-stage {
			grid-template-columns: minmax(0, 1fr) 19rem;
			align-items: center;
		}
	}

	/* Dimmer */
	.bff-dimmer-panel {
		display: grid;
		gap: 1rem;
	}
	.bff-dimmer {
		border: 0;
		padding: 0;
		margin: 0;
		min-width: 0;
	}
	.bff-dimmer legend {
		padding: 0;
		margin-bottom: 0.75rem;
		font-size: var(--bff-text-xs);
		color: var(--sl-color-gray-3);
	}
	.bff-dimmer-plate {
		display: grid;
		grid-template-columns: 2.25rem 1fr;
		gap: 0.75rem;
		padding: 0.75rem;
		border-radius: var(--bff-radius-md);
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-hairline);
	}
	.bff-dimmer-track {
		position: relative;
		border-radius: var(--bff-radius-pill);
		background: linear-gradient(to bottom, var(--bff-light-warm), var(--bff-green) 50%, var(--bff-light-night));
	}
	.bff-dimmer-knob {
		position: absolute;
		left: 50%;
		top: var(--knob-top);
		width: 2.75rem;
		height: 1.6rem;
		border-radius: var(--bff-radius-sm);
		background: var(--bff-brick-white);
		box-shadow:
			0 2px 0 var(--bff-brick-shade),
			var(--bff-shadow-sm);
		transform: translate(-50%, -50%);
		transition: top 0.55s var(--bff-ease-out);
	}
	/* Two LEGO studs on the knob. */
	.bff-dimmer-knob::before,
	.bff-dimmer-knob::after {
		content: '';
		position: absolute;
		top: -5px;
		width: 0.8rem;
		height: 0.45rem;
		border-radius: 3px 3px 0 0;
		background: var(--bff-brick-white);
		box-shadow: inset 0 -1px 0 var(--bff-brick-shade);
	}
	.bff-dimmer-knob::before { left: 0.35rem; }
	.bff-dimmer-knob::after { right: 0.35rem; }

	.bff-dimmer-stops {
		display: grid;
		grid-auto-rows: 1fr;
		gap: 0.5rem;
	}
	.bff-dimmer-stop {
		position: relative;
		display: grid;
		min-height: 3rem;
		align-content: center;
		padding: 0.35rem 0.75rem;
		border-radius: var(--bff-radius-sm);
		cursor: pointer;
		transition: background-color 0.2s var(--bff-ease-soft);
	}
	.bff-dimmer-stop:hover {
		background: var(--bff-surface-2);
	}
	.bff-dimmer-stop input {
		position: absolute;
		opacity: 0;
		inset: 0;
		margin: 0;
		cursor: pointer;
	}
	.bff-dimmer-stop:has(input:focus-visible) {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 1px;
	}
	.bff-dimmer-stop .name {
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.bff-dimmer-stop .gait {
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-2xs);
		color: var(--sl-color-gray-3);
	}
	.bff-dimmer-stop:has(input:checked) {
		background: var(--sl-color-accent-low);
	}
	.bff-dimmer-stop:has(input:checked) .name {
		color: var(--sl-color-accent-high);
	}

	/* Readouts */
	.bff-readout {
		display: none;
	}
	.bff-hero[data-level='low'] .bff-readout[data-for='low'],
	.bff-hero[data-level='medium'] .bff-readout[data-for='medium'],
	.bff-hero[data-level='high'] .bff-readout[data-for='high'] {
		display: block;
		animation: bff-fade-up 0.45s var(--bff-ease-out);
	}
	@keyframes bff-fade-up {
		from { opacity: 0; transform: translateY(6px); }
		to { opacity: 1; transform: none; }
	}
	.bff-readout-tag {
		margin: 0 0 0.75rem;
		font-size: var(--bff-text-lg);
		font-weight: 560;
		line-height: 1.35;
		color: var(--sl-color-white);
	}
	.bff-readout dl {
		display: grid;
		gap: 0.4rem;
		margin: 0;
		font-size: var(--bff-text-sm);
	}
	.bff-readout dl > div {
		display: grid;
		grid-template-columns: 5.5rem 1fr;
		gap: 0.5rem;
	}
	.bff-readout dt {
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-2xs);
		color: var(--sl-color-gray-3);
		padding-top: 0.1rem;
	}
	.bff-readout dd {
		margin: 0;
		color: var(--sl-color-gray-2);
	}
	.bff-readout-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin: 0.9rem 0 0;
		font-size: var(--bff-text-sm);
		font-weight: 600;
	}
	.bff-readout-links a {
		color: var(--sl-color-accent-high);
		text-decoration: none;
	}
	.bff-readout-links a:hover {
		text-decoration: underline;
	}

	.bff-undo-row {
		display: grid;
		gap: 0.5rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.bff-undo {
		justify-self: start;
	}
	.bff-undo-note {
		margin: 0;
		font-size: var(--bff-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
