---
import { getImage } from 'astro:assets';
import factory from '../assets/lego/cover_factory.png';
import Eyebrow from './Eyebrow.astro';
import { LEVELS, LEVEL_ORDER, withBase } from '../data/site';

const img = await getImage({ src: factory, widths: [640, 960, 1280, 1483], format: 'webp' });
const sizes = '(min-width: 72em) 52rem, 94vw';

// Pixel positions in the source render (1483 × 932) for the LED overlay.
const eyes = [
	[177, 529], [197, 529], [475, 537], [491, 537], [810, 547], [829, 547],
];
const cubes = [
	[198, 573], [288, 567], [400, 539], [681, 549], [865, 579], [941, 573],
];
const hotspots = [
	{ key: 'hq', x: 7, y: 17, label: 'Factory HQ', text: 'People bring intent, creativity, steering and judgment. Always bright.', href: '/framework/big-picture/#factory-hq' },
	{ key: 'floor', x: 7, y: 46, label: 'Factory floor', text: 'Agents do the heavy lifting. This is where the lights dim.', href: '/framework/big-picture/#factory-floor' },
	{ key: 'found', x: 7, y: 76, label: 'Foundations', text: 'Code, tools, context and identity. Stronger every loop.', href: '/framework/big-picture/#factory-foundations' },
	{ key: 'eng', x: 79, y: 24, label: 'Engineering', text: 'Tunes trust and control, expands automation, strengthens foundations.', href: '/framework/engineering/' },
];
---

<section class="bff-hero not-content" data-level="medium" aria-labelledby="bff-hero-title">
	<div class="bff-hero-copy">
		<Eyebrow text="bright-factory.init()" accent="green" />
		<p class="bff-hero-title" id="bff-hero-title">Bright Factory <span>Framework</span></p>
		<p class="bff-hero-sub">Microsoft opinionated framework for building agentic software factories.</p>
		<p class="bff-hero-lede">
			Ideas come to life. Agents do the heavy lifting. Humans monitor and control, with the lights on where it
			matters.
		</p>
		<div class="bff-hero-ctas">
			<a class="bff-btn bff-btn-primary" href={withBase('/get-started/')}>Get started <span aria-hidden="true">→</span></a>
			<a class="bff-btn" href={withBase('/get-started/find-your-level/')}>Find your level</a>
			<a class="bff-btn bff-btn-ghost" href={withBase('/fundamentals/')}>What is a software factory?</a>
		</div>
	</div>

	<div class="bff-stage">
		<div class="bff-factory">
			<img
				class="bff-factory-img"
				src={img.src}
				srcset={img.srcSet.attribute}
				sizes={sizes}
				width="1483"
				height="932"
				alt="A LEGO factory in cutaway. On the top floor, people (purple octocats) plan ideas under bright lights. On the middle floor, robot agents and robot arms build code blocks on a conveyor. In the basement, pipes and storage form the foundations. A side building holds a quality lab with rubber ducks and gauges."
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
			<img class="bff-factory-floor" src={img.src} srcset={img.srcSet.attribute} sizes={sizes} width="1483" height="932" alt="" aria-hidden="true" decoding="async" />
			<svg class="bff-leds" viewBox="0 0 1483 932" aria-hidden="true">
				<defs>
					<radialGradient id="bff-led-eye">
						<stop offset="0" class="core" />
						<stop offset=".4" class="cool" />
						<stop offset="1" class="cool fade" />
					</radialGradient>
					<radialGradient id="bff-led-cube">
						<stop offset="0" class="violet" />
						<stop offset=".5" class="violet half" />
						<stop offset="1" class="violet fade" />
					</radialGradient>
				</defs>
				{cubes.map(([x, y], i) => <circle class="cube" cx={x} cy={y} r="34" fill="url(#bff-led-cube)" style={`--i:${i}`} />)}
				{eyes.map(([x, y], i) => <circle class="eye" cx={x} cy={y} r="11" fill="url(#bff-led-eye)" style={`--i:${Math.floor(i / 2)}`} />)}
			</svg>
			<div class="bff-hq-glow" aria-hidden="true"></div>
			{
				hotspots.map((h) => (
					<a class="bff-hotspot" data-key={h.key} href={withBase(h.href)} style={`--x:${h.x}%;--y:${h.y}%`}>
						<span class="bff-hotspot-dot" aria-hidden="true" />
						<span class="bff-hotspot-label">{h.label}</span>
						<span class="bff-hotspot-text">{h.text}</span>
					</a>
				))
			}
		</div>

		<div class="bff-dimmer-panel">
			<fieldset class="bff-dimmer">
				<legend><span class="bff-mono">autonomy.dimmer</span><span class="sr-only">: choose an autonomy level</span></legend>
				<div class="bff-dimmer-plate">
					<div class="bff-dimmer-track" aria-hidden="true"><span class="bff-dimmer-knob"></span></div>
					<div class="bff-dimmer-stops">
						{
							LEVEL_ORDER.map((k) => (
								<label class="bff-dimmer-stop" data-stop={k}>
									<input type="radio" name="bff-level" value={k} checked={k === 'medium'} />
									<span class="name">{LEVELS[k].name.replace(' autonomy', '')}</span>
									<span class="gait">{LEVELS[k].gait} · {LEVELS[k].floor.toLowerCase()}</span>
								</label>
							))
						}
					</div>
				</div>
			</fieldset>

			<div class="bff-readouts">
				{
					LEVEL_ORDER.map((k) => {
						const l = LEVELS[k];
						return (
							<div class="bff-readout" data-for={k}>
								<p class="bff-readout-tag">{l.tagline}</p>
								<dl>
									<div><dt>People</dt><dd>{l.people}</dd></div>
									<div><dt>Agents</dt><dd>{l.agents}</dd></div>
									<div><dt>Approvals</dt><dd>{l.approvals}</dd></div>
									<div><dt>Mode</dt><dd><span class="bff-pill">{l.mode}</span></dd></div>
								</dl>
								<p class="bff-readout-links">
									<a href={withBase(`/levels/${k}/`)}>{l.name} <span aria-hidden="true">→</span></a>
									<a href={withBase(`/playbooks/${k}/`)}>Playbook <span aria-hidden="true">→</span></a>
								</p>
							</div>
						);
					})
				}
			</div>

			<div class="bff-undo-row">
				<button type="button" class="bff-btn bff-btn-small bff-undo" data-undo>
					<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 1.5a.75.75 0 0 1 .53.22l3 3a.75.75 0 0 1-1.06 1.06L8.75 4.06v8.19a.75.75 0 0 1-1.5 0V4.06L5.53 5.78a.75.75 0 0 1-1.06-1.06l3-3A.75.75 0 0 1 8 1.5Z"></path></svg>
					Dim back up
				</button>
				<p class="bff-undo-note" data-undo-note>Reversible by design: any work type can dim back up to keep the business running.</p>
			</div>
			<p class="sr-only" aria-live="polite" data-live></p>
		</div>
	</div>
</section>

<script>
	import { LEVELS } from '../data/site';
	type Level = 'low' | 'medium' | 'high';
	const ORDER: Level[] = ['low', 'medium', 'high'];
	const KEY = 'bff-level';

	document.querySelectorAll<HTMLElement>('.bff-hero').forEach((hero) => {
		const radios = [...hero.querySelectorAll<HTMLInputElement>('input[name="bff-level"]')];
		const live = hero.querySelector<HTMLElement>('[data-live]')!;
		const note = hero.querySelector<HTMLElement>('[data-undo-note]')!;
		const undo = hero.querySelector<HTMLButtonElement>('[data-undo]')!;
		const defaultNote = note.textContent;

		const apply = (level: Level, { announce = true, persist = true } = {}) => {
			hero.dataset.level = level;
			radios.forEach((r) => (r.checked = r.value === level));
			undo.disabled = level === 'low';
			if (persist) {
				try { localStorage.setItem(KEY, level); } catch {}
				const url = new URL(location.href);
				url.searchParams.set('level', level);
				history.replaceState(null, '', url);
			}
			if (announce) live.textContent = `${LEVELS[level].name}: ${LEVELS[level].tagline}`;
			window.dispatchEvent(new CustomEvent('bff:level', { detail: level }));
		};

		const fromUrl = new URL(location.href).searchParams.get('level') as Level | null;
		let stored: Level | null = null;
		try { stored = localStorage.getItem(KEY) as Level | null; } catch {}
		const initial = [fromUrl, stored].find((l): l is Level => !!l && ORDER.includes(l)) ?? 'medium';
		apply(initial, { announce: false, persist: !!fromUrl });

		radios.forEach((r) =>
			r.addEventListener('change', () => {
				note.textContent = defaultNote;
				apply(r.value as Level);
			})
		);

		undo.addEventListener('click', () => {
			const idx = ORDER.indexOf(hero.dataset.level as Level);
			if (idx <= 0) return;
			const next = ORDER[idx - 1];
			apply(next, { announce: false });
			hero.classList.remove('bff-incident');
			void hero.offsetWidth;
			hero.classList.add('bff-incident');
			const msg = `Dimmed back up to ${LEVELS[next].name.toLowerCase()}. Approvals return to people and work continues from the issues, pull requests and specs in Git.`;
			note.textContent = msg;
			live.textContent = msg;
		});
	});
</script>

<style>
	.bff-hero {
		--floor-filter: none;
		--floor-opacity: 0;
		--led-opacity: 0.55;
		--knob-top: 50%;
		display: grid;
		gap: clamp(2rem, 4vw, 3.5rem);
		padding-block: clamp(1rem, 3vw, 2.5rem) clamp(2rem, 5vw, 4rem);
	}
	/* Stops are equal rows with a 0.5rem gap, so their centres sit at these offsets. */
	.bff-hero[data-level='low'] {
		--floor-filter: brightness(1.75) saturate(0.85);
		--floor-opacity: 1;
		--led-opacity: 0;
		--knob-top: calc((100% - 1rem) / 6);
	}
	.bff-hero[data-level='high'] {
		--floor-filter: brightness(0.38) saturate(0.9);
		--floor-opacity: 1;
		--led-opacity: 1;
		--knob-top: calc(100% - (100% - 1rem) / 6);
	}

	/* Copy */
	.bff-hero-copy {
		max-width: 52rem;
	}
	.bff-hero-title {
		margin: 0.75rem 0 0;
		font-size: var(--bff-text-display);
		line-height: 1.02;
		font-weight: 500;
		font-variation-settings: 'wdth' 112;
		letter-spacing: -0.025em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
	.bff-hero-title span {
		color: var(--sl-color-accent);
	}
	.bff-hero-sub {
		margin: 1rem 0 0;
		font-size: var(--bff-text-lede);
		line-height: 1.3;
		color: var(--sl-color-gray-2);
		font-weight: 450;
		text-wrap: balance;
	}
	.bff-hero-lede {
		margin: 0.75rem 0 0;
		max-width: 40rem;
		font-size: var(--bff-text-lg);
		color: var(--sl-color-gray-3);
	}
	.bff-hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	/* Stage */
	.bff-stage {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.25rem;
		padding: clamp(0.75rem, 2vw, 1.5rem);
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--bff-radius);
		background:
			radial-gradient(120% 90% at 30% 10%, color-mix(in srgb, var(--bff-light-warm) 10%, transparent), transparent 60%),
			var(--bff-surface);
	}
	@media (min-width: 64em) {
		.bff-stage {
			grid-template-columns: minmax(0, 1fr) 19rem;
			align-items: center;
		}
	}

	.bff-factory {
		position: relative;
		aspect-ratio: 1483 / 932;
	}
	.bff-factory img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		user-select: none;
	}
	/* Second copy of the render, clipped to the factory floor, carries the dimming filter. */
	.bff-factory-floor {
		clip-path: inset(42.06% 32.57% 30.79% 5.93%);
		filter: var(--floor-filter);
		opacity: var(--floor-opacity);
		transition:
			filter 0.7s var(--bff-ease-soft),
			opacity 0.5s var(--bff-ease-soft);
	}
	.bff-leds {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: var(--led-opacity);
		transition: opacity 0.7s var(--bff-ease-soft);
		mix-blend-mode: screen;
		pointer-events: none;
	}
	.bff-leds .core { stop-color: var(--bff-light-core); }
	.bff-leds .cool { stop-color: var(--bff-light-cool); }
	.bff-leds .violet { stop-color: var(--bff-light-violet); stop-opacity: 0.9; }
	.bff-leds .half { stop-opacity: 0.45; }
	.bff-leds .fade { stop-opacity: 0; }
	.bff-leds .eye {
		animation: bff-blink 5s calc(var(--i) * 0.9s) infinite;
	}
	.bff-leds .cube {
		animation: bff-pulse 2.8s calc(var(--i) * 0.4s) var(--bff-ease-soft) infinite alternate;
	}
	@keyframes bff-pulse {
		from { opacity: 0.45; }
		to { opacity: 1; }
	}
	@keyframes bff-blink {
		0%, 92%, 100% { opacity: 1; }
		95% { opacity: 0.1; }
	}
	.bff-hq-glow {
		position: absolute;
		inset: 12% 34% 61% 7%;
		border-radius: var(--bff-radius-pill);
		background: radial-gradient(closest-side, color-mix(in srgb, var(--bff-light-warm) 35%, transparent), transparent);
		opacity: 0;
		transition: opacity 0.7s var(--bff-ease-soft);
		pointer-events: none;
		mix-blend-mode: screen;
	}
	.bff-hero[data-level='high'] .bff-hq-glow {
		opacity: 1;
	}

	/* Hotspots */
	.bff-hotspot {
		position: absolute;
		left: var(--x);
		top: var(--y);
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2rem;
		padding: 0.25rem 0.75rem 0.25rem 0.4rem;
		transform: translateY(-50%);
		border-radius: var(--bff-radius-pill);
		background: color-mix(in srgb, var(--sl-color-black) 92%, transparent);
		color: var(--sl-color-white);
		text-decoration: none;
		font-size: var(--bff-text-xs);
		font-weight: 600;
		box-shadow: var(--bff-shadow-sm);
		z-index: 2;
		transition: box-shadow 0.2s var(--bff-ease-soft);
	}
	.bff-hotspot-dot {
		position: relative;
		inline-size: 0.9rem;
		block-size: 0.9rem;
		border-radius: var(--bff-radius-pill);
		background: var(--c);
		flex: none;
	}
	.bff-hotspot-dot::after {
		content: '';
		position: absolute;
		inset: -4px;
		border-radius: var(--bff-radius-pill);
		border: 2px solid var(--c);
		animation: bff-ring 2.4s var(--bff-ease-out) infinite;
	}
	@keyframes bff-ring {
		from { transform: scale(0.6); opacity: 1; }
		to { transform: scale(1.8); opacity: 0; }
	}
	.bff-hotspot[data-key='hq'] { --c: var(--bff-hq); }
	.bff-hotspot[data-key='floor'] { --c: var(--bff-floor); }
	.bff-hotspot[data-key='found'] { --c: var(--bff-found); }
	.bff-hotspot[data-key='eng'] { --c: var(--bff-eng); }
	.bff-hotspot-text {
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 0;
		width: 15rem;
		padding: 0.65rem 0.8rem;
		border-radius: var(--bff-radius-md);
		background: var(--sl-color-white);
		color: var(--sl-color-black);
		font-weight: 400;
		font-size: var(--bff-text-xs);
		line-height: 1.4;
		opacity: 0;
		transform: translateY(-4px);
		pointer-events: none;
		transition:
			opacity 0.2s var(--bff-ease-soft),
			transform 0.3s var(--bff-ease-out);
	}
	.bff-hotspot[data-key='eng'] .bff-hotspot-text {
		left: auto;
		right: 0;
	}
	.bff-hotspot:is(:hover, :focus-visible) {
		box-shadow: 0 0 0 2px var(--c), var(--bff-shadow-lg);
		z-index: 3;
	}
	.bff-hotspot:is(:hover, :focus-visible) .bff-hotspot-text {
		opacity: 1;
		transform: none;
	}
	@media (max-width: 40em) {
		.bff-hotspot-label,
		.bff-hotspot-text {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
		}
		.bff-hotspot {
			padding: 0.5rem;
		}
	}

	/* Dimmer */
	.bff-dimmer-panel {
		display: grid;
		gap: 1rem;
	}
	.bff-dimmer {
		border: 0;
		padding: 0;
		margin: 0;
		min-width: 0;
	}
	.bff-dimmer legend {
		padding: 0;
		margin-bottom: 0.75rem;
		font-size: var(--bff-text-xs);
		color: var(--sl-color-gray-3);
	}
	.bff-dimmer-plate {
		display: grid;
		grid-template-columns: 2.25rem 1fr;
		gap: 0.75rem;
		padding: 0.75rem;
		border-radius: var(--bff-radius-md);
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-hairline);
	}
	.bff-dimmer-track {
		position: relative;
		border-radius: var(--bff-radius-pill);
		background: linear-gradient(to bottom, var(--bff-light-warm), var(--bff-green) 50%, var(--bff-light-night));
	}
	.bff-dimmer-knob {
		position: absolute;
		left: 50%;
		top: var(--knob-top);
		width: 2.75rem;
		height: 1.6rem;
		border-radius: var(--bff-radius-sm);
		background: var(--bff-brick-white);
		box-shadow:
			0 2px 0 var(--bff-brick-shade),
			var(--bff-shadow-sm);
		transform: translate(-50%, -50%);
		transition: top 0.55s var(--bff-ease-out);
	}
	/* Two LEGO studs on the knob. */
	.bff-dimmer-knob::before,
	.bff-dimmer-knob::after {
		content: '';
		position: absolute;
		top: -5px;
		width: 0.8rem;
		height: 0.45rem;
		border-radius: 3px 3px 0 0;
		background: var(--bff-brick-white);
		box-shadow: inset 0 -1px 0 var(--bff-brick-shade);
	}
	.bff-dimmer-knob::before { left: 0.35rem; }
	.bff-dimmer-knob::after { right: 0.35rem; }

	.bff-dimmer-stops {
		display: grid;
		grid-auto-rows: 1fr;
		gap: 0.5rem;
	}
	.bff-dimmer-stop {
		position: relative;
		display: grid;
		min-height: 3rem;
		align-content: center;
		padding: 0.35rem 0.75rem;
		border-radius: var(--bff-radius-sm);
		cursor: pointer;
		transition: background-color 0.2s var(--bff-ease-soft);
	}
	.bff-dimmer-stop:hover {
		background: var(--bff-surface-2);
	}
	.bff-dimmer-stop input {
		position: absolute;
		opacity: 0;
		inset: 0;
		margin: 0;
		cursor: pointer;
	}
	.bff-dimmer-stop:has(input:focus-visible) {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 1px;
	}
	.bff-dimmer-stop .name {
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.bff-dimmer-stop .gait {
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-2xs);
		color: var(--sl-color-gray-3);
	}
	.bff-dimmer-stop:has(input:checked) {
		background: var(--sl-color-accent-low);
	}
	.bff-dimmer-stop:has(input:checked) .name {
		color: var(--sl-color-accent-high);
	}

	/* Readouts */
	.bff-readout {
		display: none;
	}
	.bff-hero[data-level='low'] .bff-readout[data-for='low'],
	.bff-hero[data-level='medium'] .bff-readout[data-for='medium'],
	.bff-hero[data-level='high'] .bff-readout[data-for='high'] {
		display: block;
		animation: bff-fade-up 0.45s var(--bff-ease-out);
	}
	@keyframes bff-fade-up {
		from { opacity: 0; transform: translateY(6px); }
		to { opacity: 1; transform: none; }
	}
	.bff-readout-tag {
		margin: 0 0 0.75rem;
		font-size: var(--bff-text-lg);
		font-weight: 560;
		line-height: 1.35;
		color: var(--sl-color-white);
	}
	.bff-readout dl {
		display: grid;
		gap: 0.4rem;
		margin: 0;
		font-size: var(--bff-text-sm);
	}
	.bff-readout dl > div {
		display: grid;
		grid-template-columns: 5.5rem 1fr;
		gap: 0.5rem;
	}
	.bff-readout dt {
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-2xs);
		color: var(--sl-color-gray-3);
		padding-top: 0.1rem;
	}
	.bff-readout dd {
		margin: 0;
		color: var(--sl-color-gray-2);
	}
	.bff-readout-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin: 0.9rem 0 0;
		font-size: var(--bff-text-sm);
		font-weight: 600;
