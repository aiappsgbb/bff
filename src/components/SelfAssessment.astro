---
import { LEVELS, LEVEL_ORDER, withBase } from '../data/site';

const QUESTIONS = [
	{
		key: 'gates',
		area: 'Shared gates',
		q: 'Do people and agents go through the same gates?',
		hint: 'Rulesets, required reviews, CI and code scanning.',
		a: ['No, or only in some places', 'In most repositories', 'Everywhere, enforced by policy'],
		next: 'Put rulesets, CODEOWNERS, CI and code scanning in front of every change, human or agent.',
		href: '/playbooks/low/',
	},
	{
		key: 'context',
		area: 'Written context',
		q: 'Is your context written down for agents?',
		hint: 'Custom instructions, agent skills, specs, business context.',
		a: ['Not yet', 'In a few repositories', 'Versioned, reviewed and shared across teams'],
		next: 'Add custom instructions and a first agent skill to the repositories you want to automate.',
		href: '/framework/principles/',
	},
	{
		key: 'where',
		area: 'Where agents work',
		q: 'Where do agents work today?',
		hint: "On one developer's laptop, or in the cloud where the whole team can see them.",
		a: ['Mostly code completion and chat', 'On developer laptops (Copilot app, CLI, IDE)', 'In the cloud, in parallel, visible to the team'],
		next: 'Move one work type to Copilot cloud agent sessions the whole team can see and steer.',
		href: '/framework/multiplayer/',
	},
	{
		key: 'triggers',
		area: 'What starts the work',
		q: 'What starts agent work?',
		hint: 'People, events, schedules or production signals.',
		a: ['A person, every time', 'Some automations on events or schedules', 'Events, schedules and production signals'],
		next: 'Start one automation on an event or a schedule, for example a weekly dependency upgrade.',
		href: '/playbooks/medium/',
	},
	{
		key: 'identity',
		area: 'Agent identity',
		q: 'Do agents have their own identity, permissions and budget?',
		hint: 'Scoped access, audit trail and cost per agent.',
		a: ['No, they act as the user', 'Partly', 'Yes, scoped and budgeted per agent'],
		next: 'Give agents their own identities with least-privilege access and a budget per work type.',
		href: '/#factory-foundations',
	},
	{
		key: 'evidence',
		area: 'Evidence on every change',
		q: 'Does every agent change carry evidence?',
		hint: 'Tests, scans, evals, previews and a summary a reviewer can trust.',
		a: ['No', 'For some work types', 'Yes, an evidence bundle on every pull request'],
		next: 'Define the evidence bundle a reviewer needs to approve without reading every line.',
		href: '/levels/medium/',
	},
	{
		key: 'observe',
		area: 'Visibility and cost',
		q: 'Can you see what agents did, and what it cost?',
		hint: 'Sessions, tool calls, decisions and spend.',
		a: ['Not really', 'Per session, when someone looks', 'Across the organisation, with traces and cost'],
		next: 'Trace sessions and tool calls end to end and review cost per work type.',
		href: '/framework/principles/',
	},
	{
		key: 'reverse',
		area: 'Dimming back up',
		q: 'Can you move a work type back to human approvals in minutes?',
		hint: 'Dim back up without stopping the business.',
		a: ['No', 'Yes, by hand', 'Yes, one switch, and rehearsed'],
		next: 'Write down how to dim each work type back up, and rehearse it once.',
		href: '/levels/dim-back-up/',
	},
];
---

<div class="bff-assess not-content" data-assess>
	<div class="bff-assess-grid">
		<form class="bff-assess-form" novalidate>
			<p class="bff-assess-intro">
				Answer for <strong>one work type</strong>, for example dependency upgrades or feature work. Different work types can sit at
				different levels. Nothing leaves your browser.
			</p>
			<ol class="bff-assess-qs">
				{
					QUESTIONS.map((item, i) => (
						<li>
							<fieldset data-key={item.key}>
								<legend>
									<span class="bff-assess-n">{String(i + 1).padStart(2, '0')}</span>
									<span>{item.q}</span>
								</legend>
								<p class="bff-assess-hint">{item.hint}</p>
								<div class="bff-assess-options">
									{item.a.map((label, v) => (
										<label>
											<input type="radio" name={item.key} value={v} />
											<span class="bff-assess-score" aria-hidden="true">
												<span>{v}</span>
											</span>
											<span>{label}</span>
										</label>
									))}
								</div>
							</fieldset>
						</li>
					))
				}
			</ol>
			<a class="bff-assess-jump" href="#bff-assess-result">
				<span><span data-answered>0</span>/{QUESTIONS.length} answered</span>
				<span aria-hidden="true">·</span>
				<strong>See result ↓</strong>
			</a>
		</form>

		<aside class="bff-assess-result" id="bff-assess-result" aria-labelledby="bff-assess-title" tabindex="-1">
			<div class="bff-assess-sticky">
				<p class="bff-eyebrow" id="bff-assess-title"><span class="bff-eyebrow-square"></span>Your level</p>
				<div class="bff-assess-meter" aria-hidden="true"><i></i></div>
				<p class="bff-assess-progress" aria-live="polite"><span data-answered>0</span> of {QUESTIONS.length} answered</p>
				<div class="bff-assess-empty" data-empty>
					<h2>Answer the questions to see where you are.</h2>
					<p>You'll get a level, the reason, and the next three moves.</p>
				</div>
				{
					LEVEL_ORDER.map((k) => (
						<div class="bff-assess-level" data-result={k} data-level-accent={k} hidden>
							<h2>{LEVELS[k].name}</h2>
							<p class="bff-assess-tag">{LEVELS[k].tagline}</p>
						</div>
					))
				}
				<div class="bff-assess-why" data-why hidden>
					<p data-why-text></p>
					<dl class="bff-assess-reason">
						<div data-strong>
							<dt>Strongest</dt>
							<dd></dd>
						</div>
						<div data-weak>
							<dt>Holding it back</dt>
							<dd></dd>
						</div>
					</dl>
				</div>
				<div data-next hidden>
					<h3>Next moves</h3>
					<ol class="bff-assess-next"></ol>
				</div>
				<div class="bff-assess-actions" data-actions hidden>
					<a class="bff-btn bff-btn-primary bff-btn-small" data-go="level" href={withBase('/levels/')}>
						Explore your level
					</a>
					<a class="bff-btn bff-btn-small" data-go="playbook" href={withBase('/playbooks/')}>
						Open the playbook
					</a>
				</div>
				<button type="button" class="bff-btn bff-btn-ghost bff-btn-small" data-reset hidden>Start over</button>
			</div>
		</aside>
	</div>
	<script type="application/json" is:inline data-questions set:html={JSON.stringify(QUESTIONS.map(({ key, area, next, href }) => ({ key, area, next, href: withBase(href) })))} />
	<script type="application/json" is:inline data-base set:html={JSON.stringify({ levels: withBase('/levels/'), playbooks: withBase('/playbooks/') })} />
</div>

<script>
	import { shareLevel } from '../lib/tabs';

	type Level = 'low' | 'medium' | 'high';
	const STORE = 'bff:assess';
	/** The quiz result, read by LevelsStrip to mark "Your level". */
	const RESULT = 'bff:assess-level';
	const NAME: Record<Level, string> = { low: 'low autonomy', medium: 'medium autonomy', high: 'high autonomy' };
	const RANGE: Record<Level, string> = { low: 'up to 5', medium: '6 to 11', high: '12 or more' };

	document.querySelectorAll<HTMLElement>('[data-assess]').forEach((root) => {
		const form = root.querySelector('form')!;
		const qs: { key: string; area: string; next: string; href: string }[] = JSON.parse(root.querySelector('[data-questions]')!.textContent!);
		const base: { levels: string; playbooks: string } = JSON.parse(root.querySelector('[data-base]')!.textContent!);
		const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
		const meter = $('.bff-assess-meter i');
		const max = qs.length * 2;

		const read = () => {
			const scores: Record<string, number> = {};
			for (const { key } of qs) {
				const el = form.querySelector<HTMLInputElement>(`input[name="${key}"]:checked`);
				if (el) scores[key] = Number(el.value);
			}
			return scores;
		};

		const store = (key: string, value: string | null) => {
			try {
				if (value === null) localStorage.removeItem(key);
				else localStorage.setItem(key, value);
			} catch {}
		};

		const render = () => {
			const s = read();
			const answered = Object.keys(s).length;
			const total = Object.values(s).reduce((a, b) => a + b, 0);
			const done = answered === qs.length;
			root.querySelectorAll('[data-answered]').forEach((el) => (el.textContent = String(answered)));
			meter.style.inlineSize = `${((answered / qs.length) * 100).toFixed(1)}%`;
			store(STORE, JSON.stringify(s));
			$('[data-reset]').hidden = answered === 0;
			$('[data-empty]').hidden = done;
			['[data-why]', '[data-next]', '[data-actions]'].forEach((sel) => ($(sel).hidden = !done));
			root.querySelectorAll<HTMLElement>('[data-result]').forEach((el) => (el.hidden = true));
			if (!done) {
				delete root.dataset.level;
				store(RESULT, null);
				return;
			}

			const byScore: Level = total <= 5 ? 'low' : total <= 11 ? 'medium' : 'high';
			let level = byScore;
			let why = `You scored ${total} of ${max}: ${RANGE[byScore]} is ${NAME[byScore]}.`;
			if (s.gates === 0) {
				level = 'low';
				if (byScore !== 'low') why += ` Shared gates come first: without them, this work type stays at ${NAME.low}, whatever the score.`;
			} else if (s.evidence < 2 && level === 'high') {
				level = 'medium';
				why += ` Lights-off needs evidence on every change, so this work type stays at ${NAME.medium} for now.`;
			}
			root.dataset.level = level;
			$(`[data-result="${level}"]`).hidden = false;
			$('[data-why-text]').textContent = why;

			const scored = qs.map((q, i) => ({ ...q, v: s[q.key], i }));
			const hi = Math.max(...scored.map((q) => q.v));
			const lo = Math.min(...scored.map((q) => q.v));
			const areas = (v: number) =>
				`${hi === lo ? 'Every area' : scored
					.filter((q) => q.v === v)
					.map((q) => q.area)
					.join(', ')} (${v}\u00a0of\u00a02)`;
			const strong = $('[data-strong]');
			const weak = $('[data-weak]');
			strong.hidden = hi === lo && hi < 2;
			weak.hidden = hi === lo && lo === 2;
			strong.querySelector('dd')!.textContent = areas(hi);
			weak.querySelector('dd')!.textContent = areas(lo);

			$<HTMLAnchorElement>('[data-go="level"]').href = `${base.levels}${level}/`;
			$<HTMLAnchorElement>('[data-go="playbook"]').href = `${base.playbooks}${level}/`;

			const weakest = scored
				.filter((q) => q.v < 2)
				.sort((a, b) => a.v - b.v || a.i - b.i)
				.slice(0, 3);
			const list = $('.bff-assess-next');
			list.replaceChildren(
				...(weakest.length
					? weakest.map((q) => {
							const li = document.createElement('li');
							const a = document.createElement('a');
							a.href = q.href;
							a.textContent = q.next;
							li.append(a);
							return li;
						})
					: [Object.assign(document.createElement('li'), { textContent: 'Rehearse dimming back up, then pick the next work type.' })]),
			);
			store(RESULT, level);
			shareLevel(level, root);
		};

		try {
			const saved = JSON.parse(localStorage.getItem(STORE) ?? '{}') as Record<string, number>;
			for (const [k, v] of Object.entries(saved)) {
				const el = form.querySelector<HTMLInputElement>(`input[name="${k}"][value="${v}"]`);
				if (el) el.checked = true;
			}
		} catch {}
		form.addEventListener('change', render);
		$('[data-reset]').addEventListener('click', () => {
			form.reset();
			render();
			form.querySelector<HTMLInputElement>('input')?.focus();
		});
		render();
	});
</script>

<style>
	.bff-assess {
		container: assess / inline-size;
		margin-block: 2rem;
	}
	.bff-assess-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 20rem;
		gap: clamp(1.5rem, 3vw, 2.5rem);
		align-items: start;
	}
	.bff-assess-intro {
		margin: 0 0 1.25rem;
		color: var(--sl-color-gray-3);
	}
	.bff-assess-qs {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.bff-assess-qs > li {
		margin: 0;
	}
	fieldset {
		margin: 0;
		padding: 1rem 1.1rem 1.1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--bff-radius);
		background: var(--bff-surface);
	}
	legend {
		display: flex;
		gap: 0.6rem;
		float: left;
		inline-size: 100%;
		padding: 0;
		font-size: var(--bff-text-lg);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	legend + * {
		clear: both;
	}
	.bff-assess-n {
		padding-top: 0.2rem;
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-2xs);
		color: var(--sl-color-gray-3);
	}
	.bff-assess-hint {
		margin: 0.2rem 0 0.75rem 1.6rem;
		font-size: var(--bff-text-sm);
		color: var(--sl-color-gray-3);
	}
	.bff-assess-options {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.5rem;
	}
	label {
		position: relative;
		display: flex;
		gap: 0.55rem;
		align-items: flex-start;
		padding: 0.6rem 0.7rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--bff-radius-sm);
		background: var(--sl-color-black);
		font-size: var(--bff-text-sm);
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition:
			border-color 0.2s var(--bff-ease-soft),
			background-color 0.2s var(--bff-ease-soft);
	}
	label:hover {
		border-color: var(--sl-color-gray-4);
	}
	input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	/* A radio mark while answering; the points behind each option only show once the result is in. */
	.bff-assess-score {
		display: grid;
		place-items: center;
		flex: none;
		inline-size: 1.3rem;
		block-size: 1.3rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: var(--bff-radius-pill);
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-2xs);
		color: var(--sl-color-gray-3);
	}
	.bff-assess-score > span {
		display: none;
	}
	label:has(input:checked) .bff-assess-score::after {
		content: '';
		inline-size: 0.45rem;
		block-size: 0.45rem;
		border-radius: 50%;
		background: var(--bff-on-accent);
	}
	.bff-assess[data-level] .bff-assess-score > span {
		display: inline;
	}
	.bff-assess[data-level] label:has(input:checked) .bff-assess-score::after {
		content: none;
	}
	label:has(input:checked) {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
	}
	label:has(input:checked) .bff-assess-score {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--bff-on-accent);
	}
	label:has(input:focus-visible) {
		outline: 2px solid var(--sl-color-accent-high);
		outline-offset: 2px;
	}

	/* Compact progress bar for one-column layouts, where the result sits below all eight questions. */
	.bff-assess-jump {
		position: sticky;
		bottom: 0.75rem;
		z-index: 2;
		display: none;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
		align-items: center;
		justify-content: center;
		min-block-size: 2.75rem;
		margin-top: 1rem;
		padding: 0.5rem 1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--bff-radius-pill);
		background: var(--bff-surface);
		box-shadow: var(--bff-shadow-sm);
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-2xs);
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.bff-assess-jump strong {
		font-family: var(--sl-font);
		font-size: var(--bff-text-sm);
		font-weight: 600;
		color: var(--sl-color-accent-high);
	}
	.bff-assess-jump:hover strong {
		text-decoration: underline;
	}
	.bff-assess-jump:focus-visible {
		outline: 2px solid var(--sl-color-accent-high);
		outline-offset: 2px;
	}
	:global(html:has(.bff-assess-jump)) {
		scroll-padding-bottom: 5rem;
	}

	.bff-assess-result {
		position: sticky;
		top: calc(var(--sl-nav-height) + 1.5rem);
		min-inline-size: 0;
		scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
	}
	.bff-assess-result:focus {
		outline: none;
	}
	.bff-assess-sticky {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.75rem;
		padding: 1.25rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--bff-radius);
		background: var(--bff-surface);
		overflow-wrap: break-word;
	}
	.bff-assess-sticky :is(h2, h3, p, dl, dd) {
		margin: 0;
	}
	.bff-assess-meter {
		block-size: 0.4rem;
		border-radius: var(--bff-radius-pill);
		background: var(--sl-color-gray-6);
		overflow: hidden;
	}
	.bff-assess-meter i {
		display: block;
		block-size: 100%;
		inline-size: 0;
		background: linear-gradient(90deg, var(--bff-yellow), var(--bff-green), var(--bff-blue));
		background-size: 20rem 100%;
		transition: inline-size 0.5s var(--bff-ease-out);
	}
	.bff-assess-progress {
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-2xs);
		color: var(--sl-color-gray-3);
	}
	.bff-assess-empty h2 {
		font-size: var(--bff-text-lg);
		font-weight: 600;
		line-height: 1.3;
		color: var(--sl-color-white);
	}
	.bff-assess-empty p,
	.bff-assess-why {
		font-size: var(--bff-text-sm);
		color: var(--sl-color-gray-3);
	}
	.bff-assess-why {
		display: grid;
		gap: 0.6rem;
	}
	.bff-assess-reason {
		display: grid;
		gap: 0.4rem;
	}
	.bff-assess-reason dt {
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.bff-assess-reason dd {
		color: var(--sl-color-gray-2);
	}
	.bff-assess-level {
		display: grid;
		gap: 0.25rem;
		padding: 0.9rem;
		border: 1px solid color-mix(in oklab, var(--accent) 55%, transparent);
		border-radius: var(--bff-radius-md);
		background: color-mix(in oklab, var(--accent) 12%, transparent);
	}
	.bff-assess-level h2 {
		font-size: var(--bff-text-xl);
		font-weight: 600;
		line-height: 1.2;
		color: var(--sl-color-white);
	}
	.bff-assess-tag {
		font-size: var(--bff-text-sm);
		color: var(--sl-color-gray-2);
	}
	.bff-assess-sticky h3 {
		font-family: var(--bff-font-mono);
		font-size: var(--bff-text-2xs);
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	.bff-assess-next {
		display: grid;
		gap: 0.4rem;
		margin: 0.4rem 0 0;
		padding-left: 1.1rem;
		font-size: var(--bff-text-sm);
	}
	.bff-assess-next :global(a) {
		color: var(--sl-color-gray-2);
	}
	.bff-assess-next :global(a:hover) {
		color: var(--sl-color-accent-high);
	}
	.bff-assess-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.bff-assess-actions .bff-btn {
		max-inline-size: 100%;
		white-space: normal;
		text-align: center;
	}
	.bff-assess-actions[hidden],
	.bff-assess-level[hidden],
	.bff-assess-why[hidden],
	.bff-assess-reason > [hidden],
	[data-next][hidden],
	[data-reset][hidden] {
		display: none;
	}
	[data-reset] {
		justify-self: start;
	}

	/* Container units follow text size, so 200% text also drops to one column. */
	@container assess (max-width: 40rem) {
		.bff-assess-grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.bff-assess-result {
			position: static;
		}
		.bff-assess-jump {
			display: flex;
		}
	}
	@container assess (max-width: 36rem) {
		.bff-assess-options {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
